---
// A living liquid seam: Higgsfield-rendered paint in the two sections'
// colors, oozing and dripping in a seamless loop. `above`/`below` are the
// true section colors — thin gradient strips blend the video's edges into
// them so any render hue-drift is invisible. Falls back to the still.
import { withBase } from '../lib/url';

interface Props {
  id: number;
  above: string;
  below: string;
}
const { id, above, below } = Astro.props;
---

<div
  class="seam"
  aria-hidden="true"
  style="position:absolute; top:-1px; left:0; width:100%; aspect-ratio: 5.17; max-height:340px; z-index:15; pointer-events:none; overflow:hidden;"
>
  <img
    src={withBase(`/seams/seam-${id}.jpg`)}
    alt=""
    loading="lazy"
    style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top;"
    onerror="this.closest('.seam').style.display='none'"
  />
  <video
    class="seam-live lazy-planet"
    muted
    loop
    playsinline
    preload="none"
    data-src={withBase(`/seams/seam-${id}.mp4`)}
    style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top;"
  ></video>
  <div
    style={`position:absolute; top:0; left:0; right:0; height:14px; background:linear-gradient(${above}, ${above}00);`}
  >
  </div>
  <div
    style={`position:absolute; bottom:0; left:0; right:0; height:14px; background:linear-gradient(${below}00, ${below});`}
  >
  </div>
</div>
