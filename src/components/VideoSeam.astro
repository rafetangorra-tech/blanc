---
// A liquid seam: Higgsfield-rendered paint pour, re-baked to BIT-EXACT
// section colors (raw pixel math — flats are guaranteed identical to the
// section backgrounds, so the image's edges are invisible and the drips
// flow naturally with no cutoff). Full 21:9 frame used as a background
// layer; content in the section sits above the flat zone.
import { withBase } from '../lib/url';

interface Props {
  id: number;
  above: string; // kept for API compatibility; colors are baked into the asset
  below: string;
}
const { id } = Astro.props;
---

<div
  class="seam"
  aria-hidden="true"
  style="position:absolute; top:-1px; left:0; width:100%; aspect-ratio: 2.333; max-height:640px; z-index:4; pointer-events:none; overflow:hidden;"
>
  <img
    src={withBase(`/seams/seam-${id}.png`)}
    alt=""
    loading="lazy"
    style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top;"
    onerror="this.closest('.seam').style.display='none'"
  />
</div>
