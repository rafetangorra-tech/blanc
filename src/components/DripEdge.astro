---
// The previous section's color dripping down into this one — the intro's
// melt concept, systematized as the site's section-transition language.
// Place as the first child of a `relative` section; `color` = the color
// of whatever sits ABOVE this section.
interface Props {
  color: string;
}
const { color } = Astro.props;
---

<svg
  viewBox="0 0 1440 110"
  preserveAspectRatio="none"
  aria-hidden="true"
  style="position:absolute; top:-1px; left:0; width:100%; height:clamp(48px, 7vw, 84px); z-index:15; pointer-events:none; display:block;"
>
  <path
    fill={color}
    d="M0 0 L0 18 C30 14 70 24 97 20 C101 51 102 72 110 72 C118 72 119 51 123 20 C180 12 230 24 274 16 C277 32 278 42 285 42 C292 42 293 32 296 16 C350 24 400 12 445 20 C449 64 451 94 460 94 C469 94 471 64 475 20 C520 26 580 10 625 15 C627 27 629 37 635 37 C641 37 643 27 645 15 C690 20 740 26 787 21 C791 48 792 67 800 67 C808 67 809 48 813 21 C860 26 910 12 959 17 C963 68 964 103 975 103 C986 103 987 68 991 17 C1040 12 1090 26 1134 22 C1137 40 1139 56 1145 56 C1151 56 1153 40 1156 22 C1200 26 1250 12 1296 18 C1300 48 1302 76 1310 76 C1318 76 1320 48 1324 18 C1370 14 1410 24 1440 20 L1440 0 Z"
  ></path>
</svg>
