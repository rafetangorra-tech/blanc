---
// The previous section's color dripping down into this one — the intro's
// melt concept, systematized as the site's transition language.
//
// Every edge is GROWN, not stamped: a seeded generator produces a unique
// organic drip pattern per instance — varied widths, lengths, skewed tips,
// thin runs, fat beads, and the occasional detached droplet falling below.
// Same seed → same drips every build (stable), different seed → different
// liquid. Place as first child of a `relative` section; `color` = the
// color of whatever sits ABOVE.
interface Props {
  color: string;
  seed?: number;
}
const { color, seed = 1 } = Astro.props;

// deterministic PRNG (mulberry32) so each edge is stable across builds
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(seed * 9301 + 49297);
const R = (min: number, max: number) => min + rnd() * (max - min);

const W = 1440;
const H = 140;

let x = 0;
let y = R(12, 24);
let d = `M0 0 L0 ${y.toFixed(1)}`;
const droplets: string[] = [];

while (x < W - 70) {
  // meander along the underside of the band
  const gap = R(40, 125);
  const nx = Math.min(x + gap, W);
  const ny = R(11, 26);
  d += ` C${(x + gap * 0.33).toFixed(0)} ${(y + R(-7, 7)).toFixed(1)} ${(nx - gap * 0.33).toFixed(0)} ${(ny + R(-7, 7)).toFixed(1)} ${nx.toFixed(0)} ${ny.toFixed(1)}`;
  x = nx;
  y = ny;
  if (x >= W - 70) break;

  // grow a drip: narrow neck, fat bulb at the bottom (how liquid actually hangs)
  const streak = rnd() < 0.25;
  const neck = streak ? R(3, 5.5) : R(5.5, 10);
  const bulb = streak ? neck + R(1, 3) : neck + R(4, 10);
  const len = Math.min(streak ? R(70, 122) : R(22, 78), 126 - y);
  const cx = x + neck + R(-3, 3);
  const tipY = y + len;
  const skew = R(-6, 6); // gravity never pulls perfectly straight

  d += ` C${(cx - neck * 0.8).toFixed(1)} ${(y + len * 0.45).toFixed(1)} ${(cx - bulb + skew * 0.5).toFixed(1)} ${(tipY - len * 0.14).toFixed(1)} ${(cx + skew).toFixed(1)} ${tipY.toFixed(1)}`;
  d += ` C${(cx + bulb + skew * 0.5).toFixed(1)} ${(tipY - len * 0.14).toFixed(1)} ${(cx + neck * 0.8).toFixed(1)} ${(y + len * 0.45).toFixed(1)} ${(cx + neck).toFixed(1)} ${y.toFixed(1)}`;

  // occasionally a droplet has already broken free and is falling
  if (rnd() < 0.35) {
    const dy = tipY + R(9, 24);
    const r = R(2.5, 5.5);
    if (dy < H - 5) {
      droplets.push(
        `<ellipse cx="${(cx + skew + R(-2, 2)).toFixed(1)}" cy="${dy.toFixed(1)}" rx="${r.toFixed(1)}" ry="${(r * 1.35).toFixed(1)}" fill="${color}"/>`
      );
    }
  }
  x = cx + neck;
}
d += ` C${(x + (W - x) * 0.4).toFixed(0)} ${(y + R(-6, 6)).toFixed(1)} ${(W - 30).toFixed(0)} ${R(12, 22).toFixed(1)} ${W} ${R(14, 22).toFixed(1)} L${W} 0 Z`;
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  style="position:absolute; top:-1px; left:0; width:100%; height:clamp(56px, 8vw, 96px); z-index:15; pointer-events:none; display:block;"
>
  <path fill={color} d={d}></path>
  <Fragment set:html={droplets.join('')} />
</svg>
