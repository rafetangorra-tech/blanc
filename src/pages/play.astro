---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
const homeHref = withBase('/');

const games = [
  {
    href: '/produce',
    title: 'i produce',
    desc: 'Sit behind the blanc console and mix the real stems of Beautiful Woman — faders, mutes, solos.',
    tag: "rafe's chair",
    accent: '#00E5FF',
  },
  {
    href: '/sing',
    title: 'i sing',
    desc: 'Step up to the mic. Beautiful Woman with the vocal pulled down — sing it, record your cover, keep it.',
    tag: "nick's mic",
    accent: '#E8A93C',
  },
  {
    href: '/inkfall',
    title: 'inkfall',
    desc: 'You are a drop of ink falling down the blank page. Dodge the blots, catch the words — whatever you catch becomes the poem you fell into.',
    tag: "jacqueline's world",
    accent: '#C7761F',
  },
  {
    href: '/iplay',
    title: 'i play',
    desc: "Sit at Rafe's kit. Hit the notes and the real drums play — drop the sticks and the kit goes silent while the band plays on.",
    tag: "rafe's kit",
    accent: '#E23A55',
  },
];
---

<BaseLayout
  title="play — blanc"
  description="Step inside the collective — mix the stems, sing the song, write the words, pour the worlds."
>
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href={homeHref} class="text-sm uppercase tracking-[0.2em]">← blanc</a>
    <a
      href={`${homeHref}#booking`}
      class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
      >Booking</a
    >
  </header>

  <main
    class="flex min-h-screen flex-col px-6 pb-16 pt-28 sm:px-10"
    style="background: var(--canvas); color: var(--canvas-ink);"
  >
    <div class="mx-auto w-full max-w-4xl text-center">
      <p class="text-xs uppercase tracking-[0.4em] text-black/40">step inside</p>
      <h1 class="mt-3 text-6xl lowercase sm:text-7xl">play</h1>
      <p class="mx-auto mt-4 max-w-md text-black/60">
        Don't just listen to the worlds — take a seat in them.
      </p>
    </div>

    <div class="mx-auto mt-14 grid w-full max-w-4xl gap-5 sm:grid-cols-2">
      {
        games.map((g) => (
          <a
            href={withBase(g.href)}
            class="group border-t-2 pb-4 pt-5 transition-colors"
            style={`border-color:${g.accent};`}
          >
            <p class="text-xs uppercase tracking-[0.3em]" style={`color:${g.accent}`}>
              {g.tag}
            </p>
            <p class="mt-2 text-4xl lowercase tracking-tight sm:text-5xl">{g.title}</p>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-black/55">{g.desc}</p>
            <span
              class="mt-4 inline-block text-xs uppercase tracking-[0.2em] transition-transform group-hover:translate-x-1"
              style={`color:${g.accent}`}
            >
              enter →
            </span>
          </a>
        ))
      }
    </div>

    <footer class="mt-auto flex flex-col items-center gap-5 pt-16 text-xs text-black/40">
      <img
        src={withBase('/blanc-drip-logo.jpg')}
        alt="blanc"
        loading="lazy"
        class="w-40"
        style="-webkit-mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%); mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%);"
      />
      <span>© {new Date().getFullYear()} blanc — one group. many worlds.</span>
    </footer>
  </main>
</BaseLayout>
