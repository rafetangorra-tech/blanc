---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
const homeHref = withBase('/');

const games = [
  {
    href: '/produce',
    title: 'i produce',
    desc: 'Mix the real stems of Beautiful Woman at the blanc console.',
    tag: "rafe's chair",
    accent: '#00E5FF',
    img: '/produce-studio-2.jpg',
    pos: 'center 40%',
  },
  {
    href: '/sing',
    title: 'i sing',
    desc: "Follow Nick's melody line, record your cover, keep it.",
    tag: "nick's mic",
    accent: '#E8A93C',
    img: '/sing-stage.jpg',
    pos: 'center 45%',
  },
  {
    href: '/iplay',
    title: 'i play',
    desc: 'Hit the notes and the real drums play. Miss, and the kit goes silent.',
    tag: "rafe's kit",
    accent: '#E23A55',
    img: '/iplay-stage.jpg',
    pos: 'center 40%',
  },
  {
    href: '/inkfall',
    title: 'inkfall',
    desc: 'Fall down the blank page. Catch the fragments. Keep the poem.',
    tag: "jacqueline's world",
    accent: '#C7761F',
    img: '/inkfall-tile.jpg',
    pos: 'center 30%',
  },
];
---

<BaseLayout
  title="play — blanc"
  description="Step inside the collective — mix the stems, sing the melody, play the kit, fall into the poem."
>
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href={homeHref} class="text-sm uppercase tracking-[0.2em]">← blanc</a>
    <a
      href={`${homeHref}#booking`}
      class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
      >Booking</a
    >
  </header>

  <main
    class="flex min-h-screen flex-col px-4 pb-16 pt-28 sm:px-8"
    style="background: var(--canvas); color: var(--canvas-ink);"
  >
    <div class="mx-auto w-full max-w-5xl text-center">
      <p class="rise text-xs uppercase tracking-[0.4em] text-black/40" style="--d:0;">
        step inside
      </p>
      <h1 class="rise mt-3 text-7xl lowercase sm:text-8xl" style="--d:1;">play</h1>
      <p class="rise mx-auto mt-4 max-w-md text-black/60" style="--d:2;">
        Don't just listen to the worlds — take a seat in them.
      </p>
      <div class="rise mx-auto mt-5 flex justify-center gap-2" style="--d:3;" aria-hidden="true">
        {games.map((g) => <span class="h-2 w-2 rounded-full" style={`background:${g.accent}`} />)}
      </div>
    </div>

    <div class="mx-auto mt-12 grid w-full max-w-5xl gap-5 sm:grid-cols-2">
      {
        games.map((g, i) => (
          <a
            href={withBase(g.href)}
            class="tile rise group relative block overflow-hidden rounded-3xl"
            style={`--d:${4 + i}; --tile-accent:${g.accent}; aspect-ratio: 16/11;`}
          >
            <img
              src={withBase(g.img)}
              alt=""
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
              style={`object-position:${g.pos};`}
              onerror="this.style.display='none'"
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to bottom, rgba(5,4,7,0.08), rgba(5,4,7,0.12) 45%, rgba(5,4,7,0.86) 82%, rgba(5,4,7,0.94));"
            />
            <div
              class="absolute inset-x-0 top-0 h-1 opacity-80"
              style={`background:${g.accent};`}
            />
            <div class="absolute inset-x-0 bottom-0 p-6 text-left sm:p-7">
              <p
                class="text-[10px] uppercase tracking-[0.35em]"
                style={`color:${g.accent};`}
              >
                {g.tag}
              </p>
              <p class="font-display mt-1 text-4xl lowercase text-white sm:text-5xl">{g.title}</p>
              <p class="mt-2 max-w-sm text-sm leading-snug text-white/65">{g.desc}</p>
              <span
                class="mt-3 inline-block text-xs uppercase tracking-[0.25em] transition-transform duration-300 group-hover:translate-x-2"
                style={`color:${g.accent};`}
              >
                enter →
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <footer class="mt-auto flex flex-col items-center gap-5 pt-16 text-xs text-black/40">
      <img
        src={withBase('/blanc-drip-logo.jpg')}
        alt="blanc"
        loading="lazy"
        class="w-40"
        style="-webkit-mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%); mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%);"
      />
      <span>© {new Date().getFullYear()} blanc — one group. many worlds.</span>
    </footer>
  </main>

  <style>
    /* staggered entrance */
    .rise {
      opacity: 0;
      transform: translateY(22px);
      animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      animation-delay: calc(var(--d) * 90ms);
    }
    @keyframes rise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .rise {
        opacity: 1;
        transform: none;
        animation: none;
      }
    }
    /* accent glow on hover */
    .tile {
      transition: box-shadow 350ms ease, transform 350ms ease;
    }
    .tile:hover {
      transform: translateY(-4px);
      box-shadow:
        0 18px 44px rgba(5, 4, 7, 0.28),
        0 0 0 1.5px var(--tile-accent),
        0 0 34px color-mix(in srgb, var(--tile-accent) 45%, transparent);
    }
  </style>
</BaseLayout>
