---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { worlds, tracks } from '../../data/site';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return worlds.map((world) => ({
    params: { id: world.id },
    props: { world },
  }));
}

const { world } = Astro.props;
const homeHref = withBase('/');
const worldTracks = tracks.filter((t) => t.world === world.id);

// Faded collage background — a mosaic of every album cover across blanc.
const allCovers = tracks
  .filter((t) => t.artwork)
  .map((t) => t.artwork as string);
const collageCovers = allCovers.length
  ? Array.from({ length: 80 }, (_, i) => allCovers[i % allCovers.length])
  : [];
---

<BaseLayout
  title={`${world.name} — blanc`}
  description={`${world.name} (${world.genre}) — ${world.blurb}`}
>
  <!-- minimal nav -->
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href={homeHref} class="text-sm uppercase tracking-[0.2em]">← blanc</a>
    <a
      href={`${homeHref}#booking`}
      class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
      >Booking</a
    >
  </header>

  <main class="relative" style={`color:${world.ink};`}>
    <!-- faded album-art collage background -->
    <div class="collage-bg" aria-hidden="true">
      {collageCovers.map((src) => <img src={withBase(`/${src}`)} alt="" loading="lazy" />)}
    </div>
    <div
      class="collage-tint"
      aria-hidden="true"
      style={`background:
        linear-gradient(${world.bg}e0, ${world.bg}ee 55%, ${world.bg}f7),
        radial-gradient(60% 55% at 75% 18%, ${world.accent}26, transparent 70%),
        radial-gradient(45% 45% at 12% 92%, ${world.accent2}1f, transparent 70%);`}
    >
    </div>

    <div class="relative z-10">
      <!-- ============ HERO ============ -->
    <section
      class="relative mx-auto grid min-h-[85vh] max-w-6xl items-center gap-12 px-6 pb-16 pt-32 sm:px-10 lg:grid-cols-[1fr_0.8fr] lg:pt-40"
    >
      <div>
        <p
          class="reveal text-xs uppercase tracking-[0.35em]"
          style={`color:${world.accent}`}
        >
          {world.index} — {world.genre}
        </p>
        <h1
          class={`reveal mt-4 font-${world.font} text-7xl leading-[0.92] sm:text-8xl lg:text-9xl`}
        >
          {world.name}
        </h1>
        <p
          class="reveal mt-6 max-w-lg text-lg leading-relaxed"
          style={`color:${world.muted}`}
        >
          {world.blurb}
        </p>
      </div>

      <!-- planet -->
      <div class="reveal flex justify-center lg:justify-end">
        <div class="relative aspect-square w-64 max-w-full sm:w-80 lg:w-[26rem]">
          <div
            class="pointer-events-none absolute inset-[6%] rounded-full opacity-50 blur-3xl"
            style={`background: radial-gradient(circle, ${world.accent}, transparent 68%);`}
            aria-hidden="true"
          >
          </div>
          {
            world.planet ? (
              <img
                src={withBase(`/${world.planet}`)}
                alt={`${world.name} planet`}
                class="planet relative h-full w-full object-contain"
              />
            ) : (
              <div
                class="relative h-full w-full rounded-full"
                style={`background: radial-gradient(circle at 35% 30%, ${world.accent}, ${world.accent2} 55%, ${world.bg} 100%); box-shadow: inset -20px -20px 80px rgba(0,0,0,0.6);`}
                aria-hidden="true"
              />
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ THE MUSIC ============ -->
    <section class="relative mx-auto max-w-6xl px-6 pb-28 sm:px-10">
      <div class="reveal flex items-baseline justify-between">
        <p class="text-xs uppercase tracking-[0.35em]" style={`color:${world.accent}`}>
          the music
        </p>
        <p class="text-xs uppercase tracking-[0.2em]" style={`color:${world.muted}`}>
          {worldTracks.length} {worldTracks.length === 1 ? 'track' : 'tracks'}
        </p>
      </div>

      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
        {
          worldTracks.map((t) => {
            const clickable = t.released && !!t.embed;
            const linkOut = t.released && !t.embed && !!t.link;
            const Tag = clickable ? 'button' : linkOut ? 'a' : 'div';
            const caption = clickable
              ? 'Listen ▶'
              : t.released
                ? 'Out now'
                : 'Unreleased';
            return (
              <Tag
                class="reveal group block text-left"
                data-embed={clickable ? t.embed : undefined}
                data-title={t.title}
                href={linkOut ? t.link : undefined}
                target={linkOut ? '_blank' : undefined}
                rel={linkOut ? 'noopener' : undefined}
              >
                <div
                  class="relative aspect-square overflow-hidden rounded-2xl ring-1"
                  style={`--tw-ring-color:${world.ink}1f; background: linear-gradient(150deg, ${world.accent}26, ${world.accent2}18);`}
                >
                  {t.artwork ? (
                    <img
                      src={withBase(`/${t.artwork}`)}
                      alt={t.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center">
                      <span
                        class={`font-${world.font} text-5xl opacity-30`}
                        style={`color:${world.ink}`}
                      >
                        {world.index}
                      </span>
                    </div>
                  )}

                  {clickable || linkOut ? (
                    <div class="absolute inset-0 flex items-center justify-center bg-black/0 opacity-0 transition-all duration-300 group-hover:bg-black/40 group-hover:opacity-100">
                      <span
                        class="flex h-14 w-14 items-center justify-center rounded-full"
                        style={`background:${world.accent}; color:${world.bg};`}
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </div>
                  ) : !t.released ? (
                    <div class="absolute right-3 top-3">
                      <span
                        class="rounded-full px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.15em] backdrop-blur-sm"
                        style={`background:${world.bg}cc; color:${world.muted};`}
                      >
                        Coming soon
                      </span>
                    </div>
                  ) : null}
                </div>

                <div class="mt-3">
                  <p class="text-sm font-medium">{t.title}</p>
                  <p class="text-xs" style={`color:${world.muted}`}>
                    {caption}
                  </p>
                </div>
              </Tag>
            );
          })
        }
      </div>
    </section>

    <!-- ============ OTHER WORLDS ============ -->
    <section
      class="mx-auto max-w-6xl px-6 py-16 sm:px-10"
      style={`border-top:1px solid ${world.ink}1a;`}
    >
      <p class="text-xs uppercase tracking-[0.35em]" style={`color:${world.muted}`}>
        other worlds
      </p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
        {
          worlds
            .filter((w) => w.id !== world.id)
            .map((w) => (
              <a
                href={withBase(`/worlds/${w.id}`)}
                class={`group font-${w.font} text-3xl tracking-tight transition-opacity hover:opacity-100 sm:text-4xl`}
                style={`color:${world.ink}; opacity:0.4;`}
              >
                {w.name}
                <span class="opacity-0 transition-opacity group-hover:opacity-100"> →</span>
              </a>
            ))
        }
      </div>
    </section>

    <footer
      class="flex flex-col items-center justify-between gap-3 px-6 py-8 text-xs sm:flex-row"
      style={`border-top:1px solid ${world.ink}1a; color:${world.muted};`}
    >
      <a href={homeHref} class="lowercase tracking-[0.2em]">blanc</a>
      <span>© {new Date().getFullYear()} blanc — one group. many worlds.</span>
    </footer>
    </div>
  </main>

  <!-- ============ LIGHTBOX (streaming embed) ============ -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
  >
    <button
      id="lightbox-close"
      class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:bg-white hover:text-black"
      aria-label="Close"
    >
      ✕
    </button>
    <div class="w-full max-w-md">
      <p id="lightbox-title" class="mb-3 text-center text-sm uppercase tracking-[0.2em] text-white/70"></p>
      <div id="lightbox-frame" class="overflow-hidden rounded-2xl"></div>
    </div>
  </div>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    document.documentElement.classList.add('js');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);
      const lenis = new Lenis({ lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      gsap.set('.reveal', { y: 28 });
      ScrollTrigger.batch('.reveal', {
        start: 'top 90%',
        onEnter: (els) =>
          gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: 'power3.out',
            stagger: 0.07,
            overwrite: true,
          }),
        onLeaveBack: (els) =>
          gsap.to(els, {
            opacity: 0,
            y: 28,
            duration: 0.5,
            ease: 'power2.in',
            overwrite: true,
          }),
      });
      requestAnimationFrame(() => ScrollTrigger.refresh());
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }

    // ---- Lightbox for released-track streaming embeds ----
    const lightbox = document.getElementById('lightbox');
    const frame = document.getElementById('lightbox-frame');
    const titleEl = document.getElementById('lightbox-title');

    function openLightbox(embed: string, title: string) {
      if (!lightbox || !frame) return;
      frame.innerHTML = `<iframe src="${embed}" width="100%" height="400" style="border:0;border-radius:16px" loading="lazy" allow="autoplay; encrypted-media; fullscreen"></iframe>`;
      if (titleEl) titleEl.textContent = title;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    }
    function closeLightbox() {
      if (!lightbox || !frame) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      frame.innerHTML = ''; // stop playback
    }

    document.querySelectorAll<HTMLElement>('[data-embed]').forEach((el) => {
      el.addEventListener('click', () => {
        const embed = el.getAttribute('data-embed');
        const title = el.getAttribute('data-title') || '';
        if (embed) openLightbox(embed, title);
      });
    });
    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>
