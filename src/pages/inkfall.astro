---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
const homeHref = withBase('/');
---

<BaseLayout
  title="inkfall — blanc"
  description="You are a drop of ink falling down the blank page. Outrun writer's block, catch the falling fragments — recover the poem before the pen runs dry."
>
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href={homeHref} class="text-sm uppercase tracking-[0.2em]">← blanc</a>
    <p class="hidden text-xs uppercase tracking-[0.3em] text-white/60 sm:block">
      a game from the pen's world
    </p>
  </header>

  <main
    class="flex min-h-screen flex-col items-center px-4 pb-10 pt-24 sm:px-8"
    style="background: var(--canvas); color: var(--canvas-ink);"
  >
    <!-- intro -->
    <div id="ik-intro" class="flex max-w-xl flex-1 flex-col items-center justify-center text-center">
      <p class="text-xs uppercase tracking-[0.4em] opacity-50">inspired by the pen</p>
      <h1 class="mt-3 text-6xl lowercase sm:text-7xl">inkfall</h1>
      <p class="mt-5 max-w-md opacity-70">
        Somewhere down this page, a poem is falling apart. You are the ink
        sent after it. Steer with your finger or arrow keys, break through
        the <span class="font-semibold">writer's block</span>, and catch the
        falling fragments — every one you save becomes a line of the poem.
      </p>
      <p class="mt-3 text-xs uppercase tracking-[0.2em] opacity-45">
        it gets faster. it always gets faster.
      </p>
      <div class="mt-7 flex gap-2" id="ik-diffs">
        <button class="ikdiff" data-diff="easy">easy</button>
        <button class="ikdiff active" data-diff="medium">medium</button>
        <button class="ikdiff" data-diff="hard">hard</button>
      </div>
      <p id="ik-best" class="mt-4 font-mono text-sm opacity-60"></p>
      <button id="ik-start" class="ikbtn-primary mt-6">Fall</button>
    </div>

    <!-- game -->
    <div id="ik-game" class="hidden w-full max-w-[560px] flex-1 flex-col items-center">
      <div class="mb-2 flex w-full items-baseline justify-between font-mono text-sm">
        <span id="ik-dist">0m</span>
        <span id="ik-lives">🖋🖋🖋</span>
        <span id="ik-frags">0/16</span>
      </div>
      <canvas
        id="ik-canvas"
        class="w-full rounded-2xl border border-black/10"
        style="aspect-ratio: 3/4; touch-action: none; display: block;"
      ></canvas>
    </div>

    <!-- game over -->
    <div id="ik-over" class="hidden max-w-xl flex-1 flex-col items-center justify-center py-6 text-center">
      <p id="ik-over-tag" class="text-xs uppercase tracking-[0.4em] opacity-50">the pen ran dry</p>
      <p class="mt-3 font-mono text-6xl" id="ik-final-score"></p>
      <p class="mt-1 text-sm opacity-60" id="ik-final-detail"></p>
      <div class="mt-7 w-full rounded-2xl border border-black/10 bg-white/40 p-6 text-left">
        <p class="text-xs uppercase tracking-[0.35em]" style="color:#C7761F;">
          <span id="ik-poem-title"></span>
        </p>
        <div id="ik-poem" class="mt-3 text-lg italic leading-relaxed opacity-85" style="font-family: Georgia, serif;"></div>
      </div>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <button id="ik-export" class="ikbtn-primary">Keep the poem</button>
        <button id="ik-again" class="ikbtn-secondary">Fall again</button>
      </div>
      <p class="mt-8 text-[10px] uppercase tracking-[0.35em] opacity-40">
        blanc · inkfall · one group. many worlds.
      </p>
    </div>
  </main>

  <style>
    .ikbtn-primary {
      padding: 14px 38px;
      border-radius: 999px;
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 800;
      color: #f7f6f4;
      background: #101010;
      transition: transform 150ms ease;
    }
    .ikbtn-primary:hover { transform: translateY(-2px); }
    .ikbtn-secondary {
      padding: 12px 24px;
      border-radius: 999px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      border: 1px solid currentColor;
      opacity: 0.65;
    }
    .ikbtn-secondary:hover { opacity: 1; }
    .ikdiff {
      padding: 9px 20px;
      border-radius: 999px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      border: 1.5px solid currentColor;
      opacity: 0.4;
      transition: all 150ms ease;
    }
    .ikdiff.active {
      opacity: 1;
      background: #101010;
      color: #f7f6f4;
      border-color: #101010;
    }
    .ikdiff[data-diff='hard'].active {
      background: #E23A55;
      border-color: #E23A55;
    }
  </style>

  <script>
    // ————— inkfall v2 — recover the poem before the pen runs dry —————
    const $ = (id: string) => document.getElementById(id)!;
    const canvas = $('ik-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const W = 900, H = 1200;
    canvas.width = W; canvas.height = H;

    // Six original fragment-poems in the pen's voice. Written in parataxis —
    // every fragment stands alone, so ANY caught subset (kept in poem order)
    // still reads as a whole poem. Catch all 16 to recover the complete work.
    const POEMS: { title: string; frags: string[] }[] = [
      {
        title: 'the light you left on',
        frags: [
          'you left the light on', 'like a question', 'i came home late',
          'smelling of night', 'the kettle still warm', 'your name on my hands',
          'i counted the years', 'like loose change', 'we were never rich',
          'except in mornings', 'the dog knew first', 'love lives in routines',
          'in refilled glasses', 'in doors left open', 'you left the light on',
          'so i became the moth',
        ],
      },
      {
        title: 'instructions for surviving the dark',
        frags: [
          'start with your name', 'say it out loud', 'the dark is a room',
          'not a verdict', 'grief is just love', 'with nowhere to go',
          'carry water', 'carry a song', 'faith is a door',
          'you keep unlocking', 'some nights the floor', 'is enough to hold you',
          'morning is a rumor', 'believe it anyway', 'start with your name',
          'end with amen',
        ],
      },
      {
        title: 'gold',
        frags: [
          'golden hour forgives', 'everything it touches', 'your laugh in the kitchen',
          'butter and static', 'we slow danced badly', 'on purpose',
          'honesty is a window', 'left open in june', 'i keep your voice',
          'in the good glasses', 'pour it on sundays', 'when the house forgets you',
          'gold is not the metal', "it's the hour", "it's the hour",
          'we ran out of',
        ],
      },
      {
        title: '4am at the warehouse',
        frags: [
          'the bass forgives us', 'our borrowed names', 'strangers sweat like family',
          'under one strobe', 'i lost my keys', 'and found my body',
          'the night has no mirrors', 'only pulse', 'we dance like the debts',
          "are someone else's", 'the DJ prays loudest', 'hands to the ceiling',
          'dawn will card us', 'at the door', 'but not yet',
          'not yet',
        ],
      },
      {
        title: 'velvet',
        frags: [
          'desire is a red room', 'with the lights low', 'your name burns clean',
          'like good whiskey', 'i wear the ache', 'like velvet',
          'some loves arrive', 'as arson', 'we signed nothing',
          'we meant everything', 'the smoke stays', 'in the curtains',
          'call it ruin', 'call it royal', 'either way',
          "i'd burn again",
        ],
      },
      {
        title: 'self-portrait as a blank page',
        frags: [
          'i am the blank page', 'before the ink decides', "everyone i've been",
          'is a draft', 'i keep my ghosts', 'in the margins',
          'revision is mercy', 'practiced daily', "some days i'm the pen",
          'some days the spill', 'i am not finished', 'i am not afraid',
          "whiteness isn't empty", "it's listening", 'write me gently',
          'but write me',
        ],
      },
    ];

    const BANDS = [
      { name: 'the blank page', bg: '#f7f6f4', ink: '#101010', accent: '#C7761F' },
      { name: 'house world', bg: '#0B0B14', ink: '#EDEDF7', accent: '#00E5FF' },
      { name: 'golden world', bg: '#F6EAD3', ink: '#2A1D0A', accent: '#C7761F' },
      { name: 'velvet world', bg: '#150609', ink: '#F3E7EA', accent: '#E23A55' },
    ];
    const BAND_M = 300;
    const PX_PER_M = 10;

    // difficulty tiers — medium is the canonical tuning
    const DIFFS = {
      easy: { base: 140, surgeEvery: 8, surgeMult: 1.09, cap: 3.0, grow: 0.004,
        blockBase: 1.55, blockMin: 0.45, patrolP: 0.45, patrolV: 90, patrolA: 12, fragMin: 1.2 },
      medium: { base: 175, surgeEvery: 6, surgeMult: 1.12, cap: 4.2, grow: 0.006,
        blockBase: 1.3, blockMin: 0.3, patrolP: 0.6, patrolV: 110, patrolA: 20, fragMin: 1.0 },
      hard: { base: 215, surgeEvery: 4.5, surgeMult: 1.15, cap: 5.4, grow: 0.009,
        blockBase: 1.0, blockMin: 0.22, patrolP: 0.78, patrolV: 135, patrolA: 26, fragMin: 0.85 },
    } as const;
    type DiffName = keyof typeof DIFFS;
    let diffName: DiffName =
      (localStorage.getItem('blanc-inkfall-diff') as DiffName) || 'medium';
    if (!DIFFS[diffName]) diffName = 'medium';
    let D = DIFFS[diffName];

    // sounds
    let actx: AudioContext | null = null;
    function blip(f: number, d = 0.08, type: OscillatorType = 'sine', g = 0.12) {
      actx = actx || new (window.AudioContext || (window as any).webkitAudioContext)();
      const o = actx.createOscillator(), gn = actx.createGain();
      o.type = type; o.frequency.value = f;
      gn.gain.setValueAtTime(g, actx.currentTime);
      gn.gain.exponentialRampToValueAtTime(0.001, actx.currentTime + d);
      o.connect(gn); gn.connect(actx.destination);
      o.start(); o.stop(actx.currentTime + d);
    }
    const sCatch = () => { blip(740, 0.1); setTimeout(() => blip(988, 0.14), 70); };
    const sHit = () => blip(110, 0.28, 'sawtooth', 0.2);
    const sWorld = () => { blip(523, 0.1); setTimeout(() => blip(784, 0.16), 100); };
    const sSurge = () => blip(392, 0.12, 'square', 0.07);
    const sDry = () => { blip(220, 0.3, 'triangle'); setTimeout(() => blip(165, 0.5, 'triangle'), 250); };
    const sComplete = () => [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => blip(f, 0.2), i * 120));

    type Frag = { x: number; wy: number; idx: number; w: number; caught?: boolean };
    type Block = { x: number; wy: number; w: number; h: number; vx: number };

    let poem = POEMS[0];
    let player = { x: W / 2, tx: W / 2, y: 300 };
    let cam = 0, dist = 0, lives = 3, inv = 0, elapsed = 0, surges = 0, surgeFlash = 0;
    let frags: Frag[] = [], blocks: Block[] = [];
    let caught: boolean[] = [];
    let nextFrag = 0;
    let trail: { x: number; wy: number; c: string }[] = [];
    let particles: { x: number; y: number; vx: number; vy: number; life: number; c: string }[] = [];
    let running = false, last = 0, spawnF = 0, spawnB = 0, lastBand = -1;
    let bandFlash = 0, bandFlashName = '';

    const bandAt = (m: number) => BANDS[((m / BAND_M) | 0) % BANDS.length];
    const speedMult = () =>
      Math.min(D.cap, Math.pow(D.surgeMult, surges) * (1 + elapsed * D.grow));

    function pickPoem() {
      const i = (Number(localStorage.getItem('blanc-inkfall-poem') || -1) + 1) % POEMS.length;
      localStorage.setItem('blanc-inkfall-poem', String(i));
      return POEMS[i];
    }

    function reset() {
      poem = pickPoem();
      player = { x: W / 2, tx: W / 2, y: 300 };
      cam = 0; dist = 0; lives = 3; inv = 0; elapsed = 0; surges = 0; surgeFlash = 0;
      frags = []; blocks = []; trail = []; particles = [];
      caught = poem.frags.map(() => false);
      nextFrag = 0;
      spawnF = 1.2; spawnB = 1.6; lastBand = 0; bandFlash = 0;
    }

    function setTX(clientX: number) {
      const r = canvas.getBoundingClientRect();
      player.tx = ((clientX - r.left) / r.width) * W;
    }
    canvas.addEventListener('pointermove', (e) => setTX(e.clientX));
    canvas.addEventListener('pointerdown', (e) => setTX(e.clientX));
    const keys: Record<string, boolean> = {};
    addEventListener('keydown', (e) => (keys[e.key] = true));
    addEventListener('keyup', (e) => (keys[e.key] = false));

    function spawn(dt: number) {
      // fragments: the poem falls in order; missed ones come back around
      spawnF -= dt;
      if (spawnF <= 0) {
        spawnF = Math.max(D.fragMin, 2.2 - surges * 0.09);
        const remaining = poem.frags.map((_, i) => i).filter((i) => !caught[i]);
        if (remaining.length) {
          // prefer the earliest uncaught fragment, sometimes jump ahead
          const idx = Math.random() < 0.7
            ? remaining[0]
            : remaining[(Math.random() * remaining.length) | 0];
          if (!frags.some((f) => f.idx === idx && !f.caught)) {
            ctx.font = `italic 600 24px Georgia, serif`;
            const fw = ctx.measureText(poem.frags[idx]).width + 40;
            frags.push({
              x: fw / 2 + 40 + Math.random() * (W - fw - 80),
              wy: cam + H + 60,
              idx,
              w: fw,
            });
          }
        }
      }
      // writer's block
      spawnB -= dt;
      if (spawnB <= 0) {
        spawnB = Math.max(D.blockMin, D.blockBase - surges * 0.1) + Math.random() * 0.35;
        const bw = 170 + Math.random() * 130;
        blocks.push({
          x: bw / 2 + Math.random() * (W - bw),
          wy: cam + H + 60,
          w: bw,
          h: 40,
          vx: Math.random() < D.patrolP
            ? (Math.random() < 0.5 ? -1 : 1) * (D.patrolV + surges * D.patrolA)
            : 0,
        });
      }
    }

    function splash(x: number, y: number, c: string, n = 14) {
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2, v = 60 + Math.random() * 220;
        particles.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: 0.6, c });
      }
    }

    function tick(t: number) {
      if (!running) return;
      const dt = Math.min(0.05, (t - last) / 1000);
      last = t;
      elapsed += dt;
      // surge: every few seconds the page pulls harder
      if (elapsed > (surges + 1) * D.surgeEvery) {
        surges++; surgeFlash = 0.8; sSurge();
      }
      const speed = D.base * speedMult();
      cam += speed * dt;
      dist = cam / PX_PER_M;
      const band = bandAt(dist);
      const bandIdx = ((dist / BAND_M) | 0) % BANDS.length;
      if (bandIdx !== lastBand) {
        lastBand = bandIdx;
        bandFlash = 1.6; bandFlashName = band.name;
        sWorld();
      }

      if (keys['ArrowLeft'] || keys['a']) player.tx -= 460 * dt;
      if (keys['ArrowRight'] || keys['d']) player.tx += 460 * dt;
      player.tx = Math.max(30, Math.min(W - 30, player.tx));
      player.x += (player.tx - player.x) * Math.min(1, dt * 11);
      const pwy = cam + player.y;
      trail.push({ x: player.x, wy: pwy, c: band.ink });
      if (trail.length > 900) trail.shift();
      if (inv > 0) inv -= dt;

      spawn(dt);
      blocks.forEach((b) => {
        if (b.vx) {
          b.x += b.vx * dt;
          if (b.x - b.w / 2 < 20 || b.x + b.w / 2 > W - 20) b.vx = -b.vx;
        }
      });
      // catch fragments — the WHOLE pill is catchable, edges included
      frags.forEach((f) => {
        if (f.caught) return;
        const fy = f.wy - cam;
        const cx = Math.max(f.x - f.w / 2, Math.min(player.x, f.x + f.w / 2));
        const cy = Math.max(fy - 24, Math.min(player.y, fy + 24));
        if (Math.hypot(player.x - cx, player.y - cy) < 20) {
          f.caught = true;
          caught[f.idx] = true;
          splash(player.x, player.y, band.accent, 10);
          sCatch();
          $('ik-frags').textContent = `${caught.filter(Boolean).length}/16`;
          if (caught.every(Boolean)) sComplete();
        }
      });
      // writer's block collision (circle vs rect)
      if (inv <= 0) {
        for (const b of blocks) {
          const sy = b.wy - cam;
          const cx = Math.max(b.x - b.w / 2, Math.min(player.x, b.x + b.w / 2));
          const cy = Math.max(sy - b.h / 2, Math.min(player.y, sy + b.h / 2));
          if (Math.hypot(player.x - cx, player.y - cy) < 15) {
            lives--; inv = 1.2;
            splash(player.x, player.y, band.ink, 22);
            sHit();
            $('ik-lives').textContent = '🖋'.repeat(Math.max(0, lives));
            if (lives <= 0) return gameOver();
            break;
          }
        }
      }
      frags = frags.filter((f) => !f.caught && f.wy > cam - 80);
      blocks = blocks.filter((b) => b.wy > cam - 80);
      particles.forEach((p) => {
        p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 500 * dt; p.life -= dt;
      });
      particles = particles.filter((p) => p.life > 0);

      // ---- draw ----
      ctx.fillStyle = band.bg;
      ctx.fillRect(0, 0, W, H);
      if (surgeFlash > 0) {
        surgeFlash -= dt;
        ctx.fillStyle = band.ink;
        ctx.globalAlpha = surgeFlash * 0.08;
        ctx.fillRect(0, 0, W, H);
        ctx.globalAlpha = 1;
      }
      ctx.strokeStyle = band.ink + '10';
      ctx.lineWidth = 1;
      for (let y = -(cam % 90); y < H; y += 90) {
        ctx.beginPath(); ctx.moveTo(40, y); ctx.lineTo(W - 40, y); ctx.stroke();
      }
      ctx.lineWidth = 7;
      ctx.lineCap = 'round';
      for (let i = 1; i < trail.length; i++) {
        const a = trail[i - 1], b2 = trail[i];
        const sy = a.wy - cam, sy2 = b2.wy - cam;
        if (sy2 < -20 || sy > H + 20) continue;
        ctx.strokeStyle = b2.c;
        ctx.globalAlpha = 0.25 + 0.75 * (i / trail.length);
        ctx.beginPath(); ctx.moveTo(a.x, sy); ctx.lineTo(b2.x, sy2); ctx.stroke();
      }
      ctx.globalAlpha = 1;
      // fragments
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      frags.forEach((f) => {
        const sy = f.wy - cam;
        if (sy < -60 || sy > H + 60) return;
        const text = poem.frags[f.idx];
        ctx.font = `italic 600 24px Georgia, serif`;
        ctx.fillStyle = band.accent;
        ctx.beginPath();
        (ctx as any).roundRect(f.x - f.w / 2, sy - 24, f.w, 48, 24);
        ctx.fill();
        ctx.fillStyle = band.bg;
        ctx.fillText(text, f.x, sy + 1);
      });
      // writer's blocks
      blocks.forEach((b) => {
        const sy = b.wy - cam;
        if (sy < -60 || sy > H + 60) return;
        ctx.fillStyle = band.ink;
        ctx.beginPath();
        (ctx as any).roundRect(b.x - b.w / 2, sy - b.h / 2, b.w, b.h, 8);
        ctx.fill();
        ctx.fillStyle = band.bg;
        ctx.font = `800 15px 'Inter Variable', Arial, sans-serif`;
        ctx.fillText("WRITER'S BLOCK", b.x, sy + 1);
      });
      particles.forEach((p) => {
        ctx.globalAlpha = Math.max(0, p.life / 0.6);
        ctx.fillStyle = p.c;
        ctx.beginPath(); ctx.arc(p.x, p.y, 5, 0, Math.PI * 2); ctx.fill();
      });
      ctx.globalAlpha = 1;
      const blinkOff = inv > 0 && ((t / 90) | 0) % 2 === 0;
      if (!blinkOff) {
        ctx.fillStyle = band.ink;
        ctx.beginPath();
        ctx.moveTo(player.x, player.y - 26);
        ctx.bezierCurveTo(player.x + 20, player.y - 4, player.x + 16, player.y + 14, player.x, player.y + 18);
        ctx.bezierCurveTo(player.x - 16, player.y + 14, player.x - 20, player.y - 4, player.x, player.y - 26);
        ctx.fill();
        ctx.fillStyle = band.bg + '55';
        ctx.beginPath(); ctx.arc(player.x - 5, player.y + 2, 5, 0, Math.PI * 2); ctx.fill();
      }
      if (bandFlash > 0) {
        bandFlash -= dt;
        ctx.globalAlpha = Math.min(1, bandFlash);
        ctx.fillStyle = band.ink;
        ctx.font = `900 54px 'Archivo Variable', 'Arial Black', sans-serif`;
        ctx.fillText(bandFlashName, W / 2, 140);
        ctx.globalAlpha = 1;
      }

      $('ik-dist').textContent = `${dist | 0}m`;
      requestAnimationFrame(tick);
    }

    const nCaught = () => caught.filter(Boolean).length;
    const score = () => (dist | 0) + nCaught() * 40 + (caught.every(Boolean) ? 250 : 0);

    function gameOver() {
      running = false;
      const complete = caught.every(Boolean);
      complete ? sComplete() : sDry();
      const s = score();
      const bestKey = `blanc-inkfall-best-${diffName}`;
      const best = Math.max(s, Number(localStorage.getItem(bestKey) || 0));
      localStorage.setItem(bestKey, String(best));
      $('ik-over-tag').textContent = complete ? 'you recovered the whole poem' : 'the pen ran dry';
      $('ik-final-score').textContent = String(s);
      $('ik-final-detail').textContent =
        `${diffName} · ${dist | 0}m fallen · ${nCaught()}/16 fragments · best ${best}`;
      $('ik-poem-title').textContent = complete
        ? `“${poem.title}” — complete`
        : `fragments of “${poem.title}”`;
      const linesHtml = poem.frags
        .map((f, i) => (caught[i] ? `<p>${f}</p>` : null))
        .filter(Boolean)
        .join('');
      $('ik-poem').innerHTML = linesHtml || '<p class="opacity-40">(you fell in silence)</p>';
      $('ik-game').classList.add('hidden');
      $('ik-game').classList.remove('flex');
      $('ik-over').classList.remove('hidden');
      $('ik-over').classList.add('flex');
    }

    function startGame() {
      reset();
      $('ik-lives').textContent = '🖋🖋🖋';
      $('ik-frags').textContent = '0/16';
      $('ik-intro').classList.add('hidden');
      $('ik-intro').classList.remove('flex');
      $('ik-over').classList.add('hidden');
      $('ik-over').classList.remove('flex');
      $('ik-game').classList.remove('hidden');
      $('ik-game').classList.add('flex');
      running = true;
      last = performance.now();
      requestAnimationFrame(tick);
    }
    $('ik-start').addEventListener('click', startGame);
    $('ik-again').addEventListener('click', startGame);

    // difficulty selector (persisted; best score tracked per tier)
    function refreshBestLine() {
      const b = localStorage.getItem(`blanc-inkfall-best-${diffName}`);
      $('ik-best').textContent = b ? `your best ${diffName} fall: ${b}` : '';
    }
    document.querySelectorAll<HTMLElement>('.ikdiff').forEach((btn) => {
      if (btn.dataset.diff === diffName) {
        document.querySelectorAll('.ikdiff').forEach((x) => x.classList.remove('active'));
        btn.classList.add('active');
      }
      btn.addEventListener('click', () => {
        diffName = btn.dataset.diff as DiffName;
        D = DIFFS[diffName];
        localStorage.setItem('blanc-inkfall-diff', diffName);
        document.querySelectorAll('.ikdiff').forEach((x) => x.classList.remove('active'));
        btn.classList.add('active');
        refreshBestLine();
      });
    });
    refreshBestLine();

    $('ik-export').addEventListener('click', () => {
      const CW = 1080, CH = 1350;
      const c = document.createElement('canvas');
      c.width = CW; c.height = CH;
      const x = c.getContext('2d')!;
      x.fillStyle = '#f7f6f4';
      x.fillRect(0, 0, CW, CH);
      x.textAlign = 'center';
      x.fillStyle = '#C7761F';
      x.font = `600 30px 'Inter Variable', Arial, sans-serif`;
      const complete = caught.every(Boolean);
      x.fillText(complete ? `“${poem.title}”` : `fragments of “${poem.title}”`, CW / 2, 130);
      x.fillStyle = '#1a1a1a';
      x.font = `italic 500 40px Georgia, serif`;
      let y = 230;
      const lines = poem.frags.filter((_, i) => caught[i]);
      (lines.length ? lines : ['(fell in silence)']).forEach((l) => {
        x.fillText(l, CW / 2, y, CW - 160);
        y += 58;
      });
      x.fillStyle = 'rgba(0,0,0,0.45)';
      x.font = `500 26px 'Inter Variable', Arial, sans-serif`;
      x.fillText(`${diffName} · ${dist | 0}m · ${score()} pts`, CW / 2, Math.min(y + 60, CH - 220));
      x.fillStyle = '#0a0a0a';
      x.font = `900 64px 'Archivo Variable', 'Arial Black', sans-serif`;
      x.fillText('blanc', CW / 2, CH - 150);
      x.fillStyle = 'rgba(0,0,0,0.45)';
      x.font = `500 26px 'Inter Variable', Arial, sans-serif`;
      x.fillText('inkfall · one group. many worlds.', CW / 2, CH - 100);
      const a = document.createElement('a');
      a.download = 'blanc-inkfall-poem.png';
      a.href = c.toDataURL('image/png');
      a.click();
    });
  </script>
</BaseLayout>
