---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="blanc — lost world">
  <main
    class="flex h-screen flex-col items-center justify-center px-6 text-center"
    style="background: var(--canvas); color: var(--canvas-ink);"
  >
    <img
      src={withBase('/worlds/velvet-orb.jpg')}
      alt=""
      aria-hidden="true"
      class="planet w-40 sm:w-52"
    />
    <p class="mt-8 text-xs uppercase tracking-[0.4em] text-black/40">404</p>
    <h1 class="mt-3 text-5xl lowercase sm:text-6xl">this world doesn't exist</h1>
    <p class="mt-4 max-w-md text-black/60">
      Not yet, anyway. We're always writing new ones.
    </p>
    <a
      href={withBase('/')}
      class="mt-9 rounded-full border border-black/30 px-7 py-3 text-sm uppercase tracking-[0.2em] transition-colors hover:bg-black hover:text-white"
      >back to blanc</a
    >
  </main>
</BaseLayout>
