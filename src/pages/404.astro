---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="blanc — lost world">
  <main
    class="flex h-screen flex-col items-center justify-center text-center"
    style="background: var(--canvas); color: var(--canvas-ink);"
  >
    <p class="text-xs uppercase tracking-[0.4em] text-black/40">404</p>
    <h1 class="mt-4 text-6xl font-semibold tracking-tight">no world here</h1>
    <a
      href={withBase('/')}
      class="mt-8 rounded-full border border-black/30 px-6 py-2 text-sm uppercase tracking-[0.2em] transition-colors hover:bg-black hover:text-white"
      >back to blanc</a
    >
  </main>
</BaseLayout>
