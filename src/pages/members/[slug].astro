---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { members, worlds, initials } from '../../data/site';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return members.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;
const homeHref = withBase('/');
const memberWorlds = worlds.filter((w) => member.worlds.includes(w.id));
const gallery = member.gallery ?? [];
---

<BaseLayout
  title={`${member.name} — blanc`}
  description={`${member.name} — ${member.role}. Part of blanc, a songwriting collective.`}
>
  <!-- minimal nav -->
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href={homeHref} class="text-sm uppercase tracking-[0.2em]">← blanc</a>
    <a
      href={`${homeHref}#booking`}
      class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
      >Booking</a
    >
  </header>

  <main style="background: var(--canvas); color: var(--canvas-ink);">
    <!-- ============ HERO — pinned scroll-cinema ============ -->
    <section id="mhero" class="relative flex h-screen flex-col overflow-hidden">
      <!-- cinematic photo, dissolving into the blank page -->
      <div
        class="relative h-[52vh] w-full overflow-hidden"
        style="-webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 99%); mask-image: linear-gradient(to bottom, #000 55%, transparent 99%);"
      >
        {
          member.bgPhoto ? (
            <Fragment>
              <img
                id="mhero-bg"
                src={withBase(`/${member.bgPhoto}`)}
                alt=""
                class="h-full w-full object-cover object-center"
              />
              {member.heroVideo && (
                <video
                  id="mhero-dev"
                  class="absolute inset-0 hidden h-full w-full object-cover"
                  muted
                  playsinline
                  preload="auto"
                  data-src={withBase(`/${member.heroVideo}`)}
                ></video>
              )}
            </Fragment>
          ) : (
            <div
              id="mhero-bg"
              class="flex h-full w-full items-center justify-center"
              style={`background:${member.accent}14;`}
            >
              <span
                class="text-[16vw] leading-none"
                style={`color:${member.accent}; font-family:var(--font-display); font-variation-settings:'wdth' 125;`}
              >
                {initials(member.name)}
              </span>
            </div>
          )
        }
      </div>

      <!-- the name block, on the blank page -->
      <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-6 pb-16 sm:px-10">
        <p
          class="reveal text-xs uppercase tracking-[0.35em]"
          data-mh="label"
          style={`color:${member.accent}`}
        >
          blanc — the collective
        </p>
        <h1
          class="reveal mt-3 text-[11vw] uppercase leading-[0.9] sm:text-[9vw] lg:text-[7.5rem]"
          data-mh="title"
        >
          {member.name}
        </h1>
        <p class="reveal mt-4 text-lg text-black/55" data-mh="role">
          {member.role}
        </p>
        {
          memberWorlds.length > 0 && (
            <div class="reveal mt-6 flex flex-wrap gap-2" data-mh="tags">
              {memberWorlds.map((w) => (
                <a
                  href={`${homeHref}#${w.id}`}
                  class="btn-drip rounded-full border px-4 py-1.5 text-xs uppercase tracking-[0.15em]"
                  style={`border-color:${w.accent}66; color:${w.accent}; --drip:${w.accent}; --drip-ink:${w.bg};`}
                >
                  {w.name}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div
        class="scroll-cue absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-xs uppercase tracking-[0.3em] text-black/40"
        data-mh="cue"
      >
        <span class="block">scroll</span>
      </div>
    </section>

    <!-- ============ BIO — sticky portrait floods into color ============ -->
    <section class="mx-auto grid max-w-6xl gap-12 px-6 py-24 sm:px-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <div class="flood-media relative overflow-hidden rounded-2xl">
          {
            member.photo ? (
              <img
                src={withBase(`/${member.photo}`)}
                alt={member.name}
                class="w-full"
              />
            ) : (
              <div
                class="flex aspect-[4/5] w-full items-center justify-center"
                style="background:#0a0a0a;"
              >
                <span
                  class="text-7xl text-white"
                  style="font-family:var(--font-display); font-variation-settings:'wdth' 125;"
                >
                  {initials(member.name)}
                </span>
              </div>
            )
          }
        </div>
      </div>

      <div>
        <div
          class="reveal mb-8 h-1 w-20"
          style={`background:${member.accent}`}
          aria-hidden="true"
        >
        </div>
        <div class="space-y-6 text-xl leading-relaxed text-black/70">
          {member.bio.split('\n\n').map((para) => <p class="reveal">{para}</p>)}
        </div>

        {
          member.links && member.links.length > 0 && (
            <div class="reveal mt-10 flex flex-wrap gap-4">
              {member.links.map((l) => (
                <a
                  href={l.href}
                  class="text-sm uppercase tracking-[0.15em] underline-offset-4 hover:underline"
                >
                  {l.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- ============ GALLERY — images flood into color ============ -->
    {
      gallery.length > 0 && (
        <section class="mx-auto max-w-6xl px-6 pb-24 sm:px-10">
          <p class="reveal mb-8 text-xs uppercase tracking-[0.35em] text-black/40">
            gallery
          </p>
          <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
            {gallery.map((src) => (
              <div class="flood-media group relative overflow-hidden rounded-2xl">
                <img
                  src={withBase(`/${src}`)}
                  alt={member.name}
                  loading="lazy"
                  class="w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- ============ MORE OF BLANC ============ -->
    <section class="mx-auto max-w-6xl border-t border-black/10 px-6 py-20 sm:px-10">
      <p class="text-xs uppercase tracking-[0.35em] text-black/40">more of blanc</p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
        {
          members
            .filter((m) => m.slug !== member.slug)
            .map((m) => (
              <a
                href={withBase(`/members/${m.slug}`)}
                class="group text-3xl uppercase tracking-tight text-black/25 transition-colors hover:text-black sm:text-4xl"
              >
                {m.name}
                <span class="opacity-0 transition-opacity group-hover:opacity-100"> →</span>
              </a>
            ))
        }
      </div>
    </section>

    <footer
      class="flex flex-col items-center gap-5 border-t border-black/10 px-6 pb-8 pt-12 text-xs text-black/40"
      style="background: #ecece4;"
    >
      <img
        src={withBase('/blanc-drip-logo.jpg')}
        alt="blanc"
        loading="lazy"
        class="w-40 sm:w-48"
        style="-webkit-mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%); mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%);"
      />
      <span>© {new Date().getFullYear()} blanc — one group. many worlds.</span>
    </footer>
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    document.documentElement.classList.add('js');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      // ---- Hero: pinned two-act cinema ----
      // Act 1 (with heroVideo): the blank canvas DEVELOPS — liquid gold/
      // chrome/velvet pours down and reveals the photograph, scrubbed to
      // your scroll. Act 2: the identity stamps in channel by channel.
      const label = document.querySelector('[data-mh="label"]');
      const title = document.querySelector('[data-mh="title"]');
      const role = document.querySelector('[data-mh="role"]');
      const tags = document.querySelector('[data-mh="tags"]');
      const cue = document.querySelector('[data-mh="cue"]');
      const bg = document.getElementById('mhero-bg');
      const dev = document.getElementById('mhero-dev') as HTMLVideoElement | null;

      if (cue) gsap.set(cue, { opacity: 1 });

      let devReady = false;
      let pendingSeek: number | null = null;
      if (dev?.dataset.src) {
        dev.src = dev.dataset.src;
        dev.addEventListener('loadeddata', () => {
          dev.classList.remove('hidden');
          if (bg) (bg as HTMLElement).style.display = 'none';
          devReady = true;
          ScrollTrigger.refresh();
        });
        dev.addEventListener('seeked', () => {
          if (pendingSeek !== null) {
            const t = pendingSeek;
            pendingSeek = null;
            dev.currentTime = t;
          }
        });
      }
      const seekDev = (t: number) => {
        if (!dev) return;
        if (dev.seeking) pendingSeek = t;
        else dev.currentTime = t;
      };

      const hasDev = !!dev?.dataset.src;
      // channel timings: development owns the first half when present
      const T = hasDev
        ? { label: 0.56, title: 0.6, role: 0.74, tags: 0.82, cueOut: 0.5 }
        : { label: 0.04, title: 0.1, role: 0.26, tags: 0.34, cueOut: 0.3 };

      const tl = gsap.timeline({
        defaults: { ease: 'power2.out' },
        scrollTrigger: {
          trigger: '#mhero',
          start: 'top top',
          end: hasDev ? '+=170%' : '+=120%',
          pin: true,
          scrub: 0.4,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (hasDev && devReady && dev && dev.duration) {
              // development completes at 55% of the pin
              const p = Math.min(1, self.progress / 0.55);
              seekDev(Math.min(dev.duration - 0.04, p * dev.duration));
            }
          },
        },
      });

      if (bg && !hasDev)
        tl.fromTo(bg, { scale: 1.14 }, { scale: 1, ease: 'none', duration: 0.6 }, 0);
      if (label)
        tl.fromTo(label, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.1 }, T.label);
      if (title)
        tl.fromTo(
          title,
          { opacity: 0, y: 80, scale: 0.97 },
          { opacity: 1, y: 0, scale: 1, duration: 0.2 },
          T.title
        );
      if (role)
        tl.fromTo(role, { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.12 }, T.role);
      if (tags)
        tl.fromTo(tags, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.12 }, T.tags);
      if (cue) tl.to(cue, { opacity: 0, duration: 0.08 }, T.cueOut);
      tl.to({ v: 0 }, { v: 1, duration: 0.06, ease: 'none' }, 0.94);

      // ---- Color floods: portrait + gallery drain in, flood to color ----
      gsap.utils.toArray<HTMLElement>('.flood-media').forEach((m) => {
        gsap.fromTo(
          m,
          { filter: 'grayscale(1) contrast(0.94)', scale: 1.04 },
          {
            filter: 'grayscale(0) contrast(1)',
            scale: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: m,
              start: 'top 92%',
              end: 'top 38%',
              scrub: 0.5,
            },
          }
        );
      });

      // ---- Reversible reveals for bio + captions ----
      gsap.set('.reveal:not([data-mh])', { y: 28 });
      ScrollTrigger.batch('.reveal:not([data-mh])', {
        start: 'top 88%',
        onEnter: (els) =>
          gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: 'power3.out',
            stagger: 0.08,
            overwrite: true,
          }),
        onLeaveBack: (els) =>
          gsap.to(els, {
            opacity: 0,
            y: 28,
            duration: 0.5,
            ease: 'power2.in',
            overwrite: true,
          }),
      });

      requestAnimationFrame(() => ScrollTrigger.refresh());
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>
