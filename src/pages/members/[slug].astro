---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { members, worlds, initials } from '../../data/site';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return members.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;
const homeHref = withBase('/');
const memberWorlds = worlds.filter((w) => member.worlds.includes(w.id));
const gallery = member.gallery ?? [];
const BASE = '#0a0a0c';
---

<BaseLayout
  title={`${member.name} — blanc`}
  description={`${member.name} — ${member.role}. Part of blanc, a songwriting collective.`}
>
  <!-- minimal nav -->
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href={homeHref} class="text-sm uppercase tracking-[0.2em]">← blanc</a>
    <a
      href={`${homeHref}#booking`}
      class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
      >Booking</a
    >
  </header>

  <main class="relative text-white" style={`background:${BASE};`}>
    <!-- ============ HERO — cinematic, faded photo background ============ -->
    <section class="relative flex min-h-screen items-center overflow-hidden px-6 pb-20 pt-32 sm:px-10 lg:pt-40">
      <!-- background layer -->
      <div class="absolute inset-0" aria-hidden="true">
        {
          member.bgPhoto ? (
            <img
              src={withBase(`/${member.bgPhoto}`)}
              alt=""
              class="h-full w-full object-cover object-center opacity-55"
            />
          ) : null
        }
        <div
          class="absolute inset-0"
          style={`background:
            linear-gradient(to bottom, ${BASE}66, ${BASE}cc 55%, ${BASE}),
            radial-gradient(70% 60% at 78% 25%, ${member.accent}2e, transparent 70%);`}
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto grid w-full max-w-6xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p
            class="reveal text-xs uppercase tracking-[0.35em]"
            style={`color:${member.accent}`}
          >
            blanc — the collective
          </p>
          <h1
            class="reveal mt-4 text-6xl font-semibold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl"
          >
            {member.name}
          </h1>
          <p class="reveal mt-4 text-lg text-white/60">{member.role}</p>

          {
            memberWorlds.length > 0 && (
              <div class="reveal mt-6 flex flex-wrap gap-2">
                {memberWorlds.map((w) => (
                  <a
                    href={`${homeHref}#${w.id}`}
                    class="rounded-full border px-3 py-1 text-xs uppercase tracking-[0.15em] transition-colors hover:bg-white/5"
                    style={`border-color:${w.accent}66; color:${w.accent};`}
                  >
                    {w.name}
                  </a>
                ))}
              </div>
            )
          }
        </div>

        <!-- portrait — large centerpiece, shown full -->
        <div class="reveal relative">
          {
            member.photo ? (
              <Fragment>
                <div
                  class="pointer-events-none absolute -inset-8 -z-10 rounded-[40%] opacity-25 blur-3xl"
                  style={`background:radial-gradient(circle, ${member.accent}, transparent 70%);`}
                  aria-hidden="true"
                />
                <img
                  src={withBase(`/${member.photo}`)}
                  alt={member.name}
                  class="w-full rounded-2xl shadow-2xl ring-1 ring-white/10"
                />
              </Fragment>
            ) : (
              <div
                class="flex aspect-[4/5] w-full items-center justify-center rounded-2xl ring-1"
                style={`background:${member.accent}12; color:${member.accent}; --tw-ring-color:${member.accent}40;`}
              >
                <span class="font-golden text-8xl">{initials(member.name)}</span>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ BIO ============ -->
    <section class="relative mx-auto max-w-3xl px-6 py-24 sm:px-10">
      <div
        class="reveal mb-8 h-px w-16"
        style={`background:${member.accent}`}
        aria-hidden="true"
      >
      </div>
      <div class="space-y-5 text-xl leading-relaxed text-white/75">
        {member.bio.split('\n\n').map((para) => <p class="reveal">{para}</p>)}
      </div>

      {
        member.links && member.links.length > 0 && (
          <div class="reveal mt-10 flex flex-wrap gap-4">
            {member.links.map((l) => (
              <a
                href={l.href}
                class="text-sm uppercase tracking-[0.15em] underline-offset-4 hover:underline"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        )
      }
    </section>

    <!-- ============ GALLERY ============ -->
    {
      gallery.length > 0 && (
        <section class="mx-auto max-w-6xl px-6 pb-24 sm:px-10">
          <p class="reveal mb-8 text-xs uppercase tracking-[0.35em] text-white/40">
            gallery
          </p>
          <div class="columns-1 gap-4 sm:columns-2 [&>*]:mb-4">
            {gallery.map((src) => (
              <div class="reveal group relative overflow-hidden rounded-2xl ring-1 ring-white/10">
                <img
                  src={withBase(`/${src}`)}
                  alt={member.name}
                  loading="lazy"
                  class="w-full transition-transform duration-700 ease-out group-hover:scale-105"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- ============ OTHER MEMBERS ============ -->
    <section class="mx-auto max-w-6xl border-t border-white/10 px-6 py-20 sm:px-10">
      <p class="text-xs uppercase tracking-[0.35em] text-white/40">more of blanc</p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
        {
          members
            .filter((m) => m.slug !== member.slug)
            .map((m) => (
              <a
                href={withBase(`/members/${m.slug}`)}
                class="group text-3xl font-semibold tracking-tight text-white/30 transition-colors hover:text-white sm:text-4xl"
              >
                {m.name}
                <span class="opacity-0 transition-opacity group-hover:opacity-100">
                  {' '}
                  ↗
                </span>
              </a>
            ))
        }
      </div>
    </section>

    <footer
      class="flex flex-col items-center justify-between gap-3 border-t border-white/10 px-6 py-8 text-xs text-white/40 sm:flex-row"
    >
      <a href={homeHref} class="lowercase tracking-[0.2em]">blanc</a>
      <span>© {new Date().getFullYear()} blanc — one group. many worlds.</span>
    </footer>
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    document.documentElement.classList.add('js');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      gsap.set('.reveal', { y: 28 });
      ScrollTrigger.batch('.reveal', {
        start: 'top 88%',
        onEnter: (els) =>
          gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: 'power3.out',
            stagger: 0.08,
            overwrite: true,
          }),
        onLeaveBack: (els) =>
          gsap.to(els, {
            opacity: 0,
            y: 28,
            duration: 0.5,
            ease: 'power2.in',
            overwrite: true,
          }),
      });

      requestAnimationFrame(() => ScrollTrigger.refresh());
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>
