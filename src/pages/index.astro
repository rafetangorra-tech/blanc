---
import BaseLayout from '../layouts/BaseLayout.astro';
import DripEdge from '../components/DripEdge.astro';
import { site, worlds, members, initials } from '../data/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const CANVAS = '#f7f6f4';
---

<BaseLayout>
  <!-- Scroll progress -->
  <!-- scroll progress — a thin gold drip line filling across the top -->
  <div
    id="progress"
    class="fixed left-0 top-0 z-50 h-[3px] w-full origin-left scale-x-0"
    style="background: linear-gradient(90deg, #C7761F, #E8A93C 60%, #F3C566);"
    aria-hidden="true"
  >
  </div>

  <!-- Fixed nav — mix-blend-difference keeps it legible over any world -->
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href="#top" class="font-display text-xl lowercase">blanc</a>
    <nav class="flex items-center gap-4 sm:gap-6" aria-label="Worlds">
      {
        worlds.map((w) => (
          <a
            href={`#${w.id}`}
            data-dot={w.id}
            class="group hidden items-center gap-2 text-xs uppercase tracking-[0.2em] transition-opacity sm:flex"
          >
            <span class="dot h-1.5 w-1.5 rounded-full bg-white/40 transition-all group-hover:bg-white" />
            {w.name.replace(' World', '')}
          </a>
        ))
      }
      <a
        href="#collective"
        class="hidden text-xs uppercase tracking-[0.2em] transition-opacity hover:opacity-60 sm:inline"
        >Collective</a
      >
      <a
        href={withBase('/produce')}
        class="hidden text-xs uppercase tracking-[0.2em] transition-opacity hover:opacity-60 sm:inline"
        >I Produce</a
      >
      <a
        href="#booking"
        class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
        >Booking</a
      >
    </nav>
  </header>

  <main id="top">
    <!-- ============ INTRO — the blank page ============ -->
    <section
      id="intro"
      class="relative flex h-screen items-center justify-center overflow-hidden"
      style="background: var(--canvas); color: var(--canvas-ink);"
    >
      <p
        class="reveal absolute top-24 left-1/2 z-10 -translate-x-1/2 text-center text-xs uppercase tracking-[0.4em] text-black/40"
      >
        songwriting collective
      </p>
      <h1 id="wordmark" class="w-full px-6 text-center">
        <span class="block text-[18vw] leading-none sm:text-[14vw] lg:text-[12rem]"
          >blanc</span
        >
        <!-- material-transformation wordmark: a full-bleed layer. The frame's
             generous cream margins make cover-cropping safe on landscape;
             portrait screens fall back to contain so letters never clip. -->
        <video
          id="wordmark-video"
          class="absolute inset-0 hidden h-full w-full object-contain md:object-cover"
          muted
          playsinline
          preload="auto"
          data-src={withBase('/blanc-transform.mp4')}
        />
      </h1>
      <p
        class="reveal absolute bottom-20 left-1/2 z-10 w-full -translate-x-1/2 px-6 text-center text-lg text-black/60 sm:text-xl"
      >
        {site.tagline}
      </p>

      <div
        class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-xs uppercase tracking-[0.3em] text-black/40"
      >
        <span class="block">scroll</span>
      </div>
    </section>

    <!-- ============ WORLDS ============ -->
    {
      worlds.map((w, wi) => (
        <section
          id={w.id}
          class="world relative flex min-h-screen items-center overflow-hidden px-6 py-24 sm:px-10"
          data-accent={w.accent}
          style={`background:${w.bg}; color:${w.ink};`}
        >
          {/* melt curtain: you arrive covered in the previous world's color —
              scrolling melts it down and away, drips trailing off-screen */}
          <div
            class="melt-curtain"
            aria-hidden="true"
            style={`position:absolute; left:0; top:0; width:100%; height:100%; z-index:30; pointer-events:none; background:${wi === 0 ? CANVAS : worlds[wi - 1].bg}; will-change:transform;`}
          >
            <DripEdge color={wi === 0 ? CANVAS : worlds[wi - 1].bg} seed={17 + wi * 23} attach="bottom" />
          </div>
          {/* ambient glow */}
          <div
            class="pointer-events-none absolute inset-0"
            aria-hidden="true"
            style={`background:
              radial-gradient(60% 60% at 72% 28%, ${w.accent}26, transparent 70%),
              radial-gradient(50% 50% at 18% 82%, ${w.accent2}1f, transparent 70%);`}
          />
          <div class="relative z-10 mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
            <div>
              <p
                class="reveal mb-4 text-xs uppercase tracking-[0.35em]"
                data-wtext="label"
                style={`color:${w.accent}`}
              >
                {w.index} — {w.genre}
              </p>
              <h2
                class={`reveal font-${w.font} text-6xl uppercase leading-[0.95] sm:text-7xl lg:text-8xl`}
                data-wtext="title"
              >
                {w.name}
              </h2>
              <p
                class="reveal mt-6 max-w-lg text-lg leading-relaxed"
                data-wtext="blurb"
                style={`color:${w.muted}`}
              >
                {w.blurb}
              </p>
            </div>

            {/* planet + enter-world CTA */}
            <div class="flex flex-col items-center gap-8 lg:items-start">
              {w.planet && (
                <a
                  href={withBase(`/worlds/${w.id}`)}
                  data-speed="1.3"
                  class="reveal group relative block w-52 sm:w-64 lg:w-80"
                  aria-label={`Enter ${w.name}`}
                >
                  <div
                    class="pointer-events-none absolute inset-[6%] rounded-full opacity-40 blur-3xl transition-opacity duration-500 group-hover:opacity-70"
                    style={`background: radial-gradient(circle, ${w.accent}, transparent 68%);`}
                    aria-hidden="true"
                  />
                  <div class="planet relative aspect-square w-full">
                    <img
                      src={withBase(`/${w.planet}`)}
                      alt=""
                      aria-hidden="true"
                      class="h-full w-full object-contain"
                    />
                    {w.planetVideo && (
                      <video
                        class="planet-video lazy-planet"
                        muted
                        playsinline
                        preload="none"
                        poster={withBase(`/${w.planet}`)}
                        data-src={withBase(`/${w.planetVideo}`)}
                        data-scrub
                      />
                    )}
                  </div>
                </a>
              )}
              <div
                class="reveal flex flex-col items-center"
                data-wtext="cta"
                data-speed="0.6"
              >
                <a
                  href={withBase(`/worlds/${w.id}`)}
                  class="btn-drip group inline-flex items-center gap-3 rounded-full border px-7 py-4 text-sm font-medium uppercase tracking-[0.2em]"
                  style={`border-color:${w.accent}66; color:${w.ink}; --drip:${w.accent}; --drip-ink:${w.bg};`}
                >
                  Enter {w.name}
                  <span
                    class="transition-transform group-hover:translate-x-1"
                    style={`color:${w.accent}`}
                    >→</span
                  >
                </a>
                <p class="mt-3 text-center text-sm" style={`color:${w.muted}`}>
                  explore the music &amp; artwork
                </p>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- ============ THE COLLECTIVE ============ -->
    <section
      id="collective"
      class="relative overflow-hidden py-28"
      style="background: var(--canvas); color: var(--canvas-ink);"
    >
      <div
        class="melt-curtain"
        aria-hidden="true"
        style="position:absolute; left:0; top:0; width:100%; height:100%; z-index:30; pointer-events:none; background:#150609; will-change:transform;"
      >
        <DripEdge color="#150609" seed={101} attach="bottom" />
      </div>
      <div class="relative z-10 mx-auto max-w-6xl px-6 pt-8 sm:px-10">
        <p class="reveal text-xs uppercase tracking-[0.4em] text-black/40">
          the collective
        </p>
        <h2 class="reveal mt-4 max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">
          Three writers. One blank page.
        </h2>
      </div>

      <!-- group portrait, full-bleed cinematic (landscape screens) — colors in on scroll -->
      <div class="reveal group-photo relative mt-12 hidden md:block">
        <div class="group-photo-media group-photo-wide relative h-[92vh] min-h-[520px] w-full overflow-hidden">
          <img
            src={withBase('/members/blanc-group-wide.jpg')}
            alt="blanc — Nick Tangorra, Jacqueline Tangorra, and Rafe Tangorra"
            class="absolute inset-0 h-full w-full scale-[1.15] object-cover object-[center_22%] origin-[50%_12%]"
          />
          <video
            class="lazy-planet scale-[1.15] origin-[50%_12%]"
            style="object-position: center 22%"
            muted
            loop
            playsinline
            preload="none"
            poster={withBase('/members/blanc-group-wide.jpg')}
            data-src={withBase('/members/blanc-group-wide.mp4')}
          />
        </div>
      </div>

      <!-- group portrait, contained square (portrait screens) -->
      <div class="reveal group-photo relative mx-auto mt-12 max-w-4xl px-6 md:hidden">
        <div class="group-photo-media group-photo-fade relative overflow-hidden">
          <img
            src={withBase('/members/blanc-group.jpg')}
            alt="blanc — Nick Tangorra, Jacqueline Tangorra, and Rafe Tangorra"
            class="w-full scale-[1.15] origin-[50%_15%]"
          />
          <video
            class="lazy-planet scale-[1.15] origin-[50%_15%]"
            muted
            loop
            playsinline
            preload="none"
            poster={withBase('/members/blanc-group.jpg')}
            data-src={withBase('/members/blanc-group.mp4')}
          />
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-6 sm:px-10">
        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            members.map((m) => (
              <a
                href={withBase(`/members/${m.slug}`)}
                class="reveal group border-t-2 pt-5 transition-colors"
                style={`border-color:${m.accent};`}
              >
                <div
                  class="flex h-44 items-center justify-center overflow-hidden"
                  style={m.photo ? '' : 'background:#0a0a0a;'}
                >
                  {m.photo ? (
                    <img
                      src={withBase(`/${m.photo}`)}
                      alt={m.name}
                      class="h-full w-full scale-[1.6] object-cover object-[center_20%] origin-[59%_26%] transition-transform duration-700 ease-out group-hover:scale-[1.67]"
                      loading="lazy"
                    />
                  ) : (
                    <span class="text-6xl text-white" style="font-family: var(--font-display); font-variation-settings: 'wdth' 125;">
                      {initials(m.name)}
                    </span>
                  )}
                </div>
                <h3 class="mt-5 text-2xl tracking-tight">{m.name}</h3>
                <p class="mt-1 text-sm text-black/50">{m.role}</p>
                <span
                  class="mt-3 inline-block text-xs uppercase tracking-[0.2em] transition-transform group-hover:translate-x-1"
                  style={`color:${m.accent}`}
                >
                  View page →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ BOOKING / CONTACT ============ -->
    <section
      id="booking"
      class="relative flex min-h-[80vh] items-center justify-center overflow-hidden px-6 py-24 text-center"
      style="background: var(--canvas-ink); color: var(--canvas);"
    >
      <div
        class="melt-curtain"
        aria-hidden="true"
        style={`position:absolute; left:0; top:0; width:100%; height:100%; z-index:30; pointer-events:none; background:${CANVAS}; will-change:transform;`}
      >
        <DripEdge color={CANVAS} seed={137} attach="bottom" />
      </div>
      <div class="relative z-10 max-w-2xl pt-10">
        <!-- the three worlds, together -->
        <div class="reveal mb-8 flex items-end justify-center gap-4" aria-hidden="true">
          {
            worlds.map((w) => (
              <img
                src={withBase(`/${w.planet}`)}
                alt=""
                loading="lazy"
                class="planet w-16 sm:w-20"
                style="animation-delay: calc(-3s * var(--i, 0));"
              />
            ))
          }
        </div>
        <p class="reveal text-xs uppercase tracking-[0.4em] text-white/40">
          work with blanc
        </p>
        <h2 class="reveal mt-5 text-5xl font-semibold leading-tight sm:text-6xl">
          Let's make something<br />that has no genre.
        </h2>
        <p class="reveal mx-auto mt-6 max-w-lg text-white/60">
          Booking, sync licensing, features, co-writes — we're open. Tell us
          which world you're calling from.
        </p>
        <a
          href={`mailto:${site.bookingEmail}`}
          class="reveal mt-9 inline-block rounded-full bg-white px-8 py-3 text-sm font-medium uppercase tracking-[0.2em] text-black transition-transform hover:-translate-y-0.5"
        >
          Get in touch
        </a>
      </div>
    </section>

    <footer
      class="flex flex-col items-center gap-5 px-6 pb-8 pt-12 text-xs text-black/40"
      style="background: #ecece4;"
    >
      <img
        src={withBase('/blanc-drip-logo.jpg')}
        alt="blanc"
        loading="lazy"
        class="w-40 sm:w-48"
        style="-webkit-mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%); mask-image: radial-gradient(120% 120% at 50% 50%, #000 55%, transparent 96%);"
      />
      <span>© {year} blanc — one group. many worlds.</span>
    </footer>
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    const root = document.documentElement;
    root.classList.add('js');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      // ---- Smooth scroll (Lenis) wired into GSAP's ticker ----
      const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      // Anchor links scroll smoothly through Lenis
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          lenis.scrollTo(target, { offset: 0, duration: 1.2 });
        });
      });

      // ---- Intro: wordmark reacts to scroll (the signature moment) ----
      gsap.set('.reveal', { y: 32 });
      gsap.to('.reveal', {}); // no-op to ensure plugin init order

      // Intro reveal on load
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .to('#intro .reveal', { opacity: 1, y: 0, duration: 1, stagger: 0.15 }, 0.2);

      // Wordmark text spreads + fades as you leave the blank page
      // (targets the text span only, so it never dims the transform video)
      gsap.to('#wordmark span', {
        letterSpacing: '0.15em',
        opacity: 0.15,
        ease: 'none',
        scrollTrigger: {
          trigger: '#intro',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      // ---- The blank page transforms: pin the intro and let scroll pour
      // the three worlds' materials onto the BLANC letters. Backward strips
      // them clean.
      //
      // IMPORTANT: this pin is created HERE, synchronously, BEFORE the world
      // pins — pinned ScrollTriggers must be registered in document order or
      // every section below gets stale scroll math (blank-void bug). The
      // video merely swaps in visually whenever it finishes loading.
      const wmVideo = document.getElementById('wordmark-video') as HTMLVideoElement | null;
      const wmText = document.querySelector<HTMLElement>('#wordmark span');
      if (wmVideo?.dataset.src) {
        wmVideo.src = wmVideo.dataset.src;

        // Seek manager: never stack seeks — while the browser is mid-seek,
        // remember only the latest target and apply it on 'seeked'.
        let pendingSeek: number | null = null;
        const seekTo = (t: number) => {
          if (wmVideo.seeking) {
            pendingSeek = t;
          } else {
            wmVideo.currentTime = t;
          }
        };
        wmVideo.addEventListener('seeked', () => {
          if (pendingSeek !== null) {
            const t = pendingSeek;
            pendingSeek = null;
            wmVideo.currentTime = t;
          }
        });

        ScrollTrigger.create({
          trigger: '#intro',
          start: 'top top',
          end: '+=160%',
          pin: true,
          scrub: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (wmVideo.readyState >= 2 && wmVideo.duration) {
              // Melt completes at 85% — release comes right on the final
              // frame's heels (the last 15% is just seek-lag insurance).
              const p = Math.min(1, self.progress / 0.85);
              seekTo(Math.min(wmVideo.duration - 0.04, p * wmVideo.duration));
            }
          },
        });

        wmVideo.addEventListener('loadeddata', () => {
          wmVideo.classList.remove('hidden');
          if (wmText) wmText.style.display = 'none';
          ScrollTrigger.refresh();
        });
      }

      // ---- Per-world reveals, parallax, and nav sync ----
      gsap.utils.toArray('.world').forEach((section) => {
        const el = section as HTMLElement;

        // (world text is driven by the pinned mix-in timeline below, not here)

        // planet scrubs in with the scroll — grows/settles as the world arrives,
        // shrinks back as you leave. Fully tied to scroll position.
        const planetWrap = el.querySelector('a[aria-label^="Enter"]');
        if (planetWrap) {
          gsap.fromTo(
            planetWrap,
            { scale: 0.55, opacity: 0.3 },
            {
              scale: 1,
              opacity: 1,
              ease: 'none',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                end: 'center center',
                scrub: 0.6,
              },
            }
          );
        }

        // parallax layers
        el.querySelectorAll('[data-speed]').forEach((layer) => {
          const l = layer as HTMLElement;
          const speed = parseFloat(l.dataset.speed || '1');
          gsap.to(l, {
            yPercent: -10 * speed,
            ease: 'none',
            scrollTrigger: {
              trigger: el,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          });
        });

        // active nav dot
        const dot = document.querySelector(`[data-dot="${el.id}"] .dot`);
        ScrollTrigger.create({
          trigger: el,
          start: 'top 50%',
          end: 'bottom 50%',
          onToggle: (self) => {
            if (!dot) return;
            dot.classList.toggle('!bg-white', self.isActive);
            (dot as HTMLElement).style.transform = self.isActive ? 'scale(2)' : '';
          },
        });
      });

      // Collective section reveal — reversible
      gsap.to('#collective .reveal', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        stagger: 0.08,
        scrollTrigger: {
          trigger: '#collective',
          start: 'top 75%',
          toggleActions: 'play none none reverse',
        },
      });

      // Booking section reveal — reversible
      gsap.to('#booking .reveal', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        stagger: 0.1,
        scrollTrigger: {
          trigger: '#booking',
          start: 'top 70%',
          toggleActions: 'play none none reverse',
        },
      });

      // ---- Group portrait: emerges from the blank page — scrubbed both ways.
      // Starts oversized and drained of color, settles + floods to full color.
      gsap.utils.toArray<HTMLElement>('.group-photo-media').forEach((media) => {
        gsap.fromTo(
          media,
          { scale: 1.12, filter: 'grayscale(1) contrast(0.92) brightness(1.05)' },
          {
            scale: 1,
            filter: 'grayscale(0) contrast(1) brightness(1)',
            ease: 'none',
            scrollTrigger: {
              trigger: media,
              start: 'top 92%',
              end: 'top 30%',
              scrub: 0.5,
            },
          }
        );
      });

      // ---- Lazy living media: load as it approaches. Scrub videos never
      // autoplay — the scrollbar is their playhead. Ambient videos loop.
      const lazyPlanets = document.querySelectorAll<HTMLVideoElement>('.lazy-planet');
      if (lazyPlanets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const v = entry.target as HTMLVideoElement;
              const isScrub = v.dataset.scrub !== undefined;
              if (entry.isIntersecting) {
                if (!v.src && v.dataset.src) {
                  v.src = v.dataset.src;
                  v.preload = 'auto';
                  v.load();
                }
                if (!isScrub) v.play().catch(() => {});
              } else if (!isScrub) {
                v.pause();
              }
            });
          },
          { rootMargin: '600px' }
        );
        lazyPlanets.forEach((v) => io.observe(v));
      }

      // ---- ULTRA reactive: pin each world; scroll drives BOTH the orb's spin
      // and the mix-in of every text layer. Forward builds the mix, backward
      // strips it — the scrollbar is the fader.
      // reveal the melt curtains only when the scroll engine is driving
      document
        .querySelectorAll<HTMLElement>('.melt-curtain')
        .forEach((c) => (c.style.display = 'block'));

      gsap.utils.toArray<HTMLElement>('.world').forEach((el) => {
        const vid = el.querySelector<HTMLVideoElement>('video[data-scrub]');
        const curtain = el.querySelector<HTMLElement>('.melt-curtain');
        const label = el.querySelector('[data-wtext="label"]');
        const title = el.querySelector('[data-wtext="title"]');
        const blurb = el.querySelector('[data-wtext="blurb"]');
        const cta = el.querySelector('[data-wtext="cta"]');

        const tl = gsap.timeline({
          defaults: { ease: 'power2.out' },
          scrollTrigger: {
            trigger: el,
            start: 'top top',
            end: '+=140%',
            pin: true,
            scrub: 0.4,
            anticipatePin: 1,
            onUpdate: (self) => {
              if (vid && vid.readyState >= 2 && vid.duration) {
                vid.currentTime = Math.min(
                  vid.duration - 0.05,
                  self.progress * vid.duration
                );
              }
            },
          },
        });

        // Act 1 — the previous world melts down and away (drips trailing)
        if (curtain)
          tl.to(curtain, { yPercent: 130, duration: 0.2, ease: 'none' }, 0);
        // Act 2 — the mix builds channel by channel; the orb spins throughout
        if (label)
          tl.fromTo(label, { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.1 }, 0.2);
        if (title)
          tl.fromTo(
            title,
            { opacity: 0, y: 70, scale: 0.96 },
            { opacity: 1, y: 0, scale: 1, duration: 0.18 },
            0.24
          );
        if (blurb)
          tl.fromTo(blurb, { opacity: 0, y: 34 }, { opacity: 1, y: 0, duration: 0.14 }, 0.32);
        if (cta)
          tl.fromTo(cta, { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.14 }, 0.4);
        // spacer so the mix completes and the rest of the pin is pure spin
        tl.to({ v: 0 }, { v: 1, duration: 0.45, ease: 'none' }, 0.55);
      });

      // Collective + booking melt in as they arrive (scrubbed, unpinned)
      gsap
        .utils.toArray<HTMLElement>('#collective .melt-curtain, #booking .melt-curtain')
        .forEach((c) => {
          gsap.to(c, {
            yPercent: 130,
            ease: 'none',
            scrollTrigger: {
              trigger: c.closest('section'),
              start: 'top 60%',
              end: 'top 2%',
              scrub: 0.4,
            },
          });
        });

      // ---- Scroll progress bar ----
      gsap.to('#progress', {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: document.body,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
        },
      });

      // Recalculate once fonts/layout settle
      requestAnimationFrame(() => ScrollTrigger.refresh());
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>
