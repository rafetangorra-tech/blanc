---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, worlds, members, initials, tracks } from '../data/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();

// Faded album-art collage — a mosaic of every cover, shown behind each world.
const allCovers = tracks.filter((t) => t.artwork).map((t) => t.artwork as string);
const collageCovers = allCovers.length
  ? Array.from({ length: 60 }, (_, i) => allCovers[i % allCovers.length])
  : [];
---

<BaseLayout>
  <!-- Scroll progress -->
  <div
    id="progress"
    class="fixed left-0 top-0 z-50 h-[3px] w-full origin-left scale-x-0 bg-current"
    aria-hidden="true"
  >
  </div>

  <!-- Fixed nav — mix-blend-difference keeps it legible over any world -->
  <header
    class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-5 py-4 text-white mix-blend-difference sm:px-8"
  >
    <a href="#top" class="font-display text-xl lowercase">blanc</a>
    <nav class="flex items-center gap-4 sm:gap-6" aria-label="Worlds">
      {
        worlds.map((w) => (
          <a
            href={`#${w.id}`}
            data-dot={w.id}
            class="group hidden items-center gap-2 text-xs uppercase tracking-[0.2em] transition-opacity sm:flex"
          >
            <span class="dot h-1.5 w-1.5 rounded-full bg-white/40 transition-all group-hover:bg-white" />
            {w.name.replace(' World', '')}
          </a>
        ))
      }
      <a
        href="#collective"
        class="hidden text-xs uppercase tracking-[0.2em] transition-opacity hover:opacity-60 sm:inline"
        >Collective</a
      >
      <a
        href="#booking"
        class="rounded-full border border-white/50 px-4 py-1.5 text-xs uppercase tracking-[0.2em] transition-colors hover:bg-white hover:text-black"
        >Booking</a
      >
    </nav>
  </header>

  <main id="top">
    <!-- ============ INTRO — the blank page ============ -->
    <section
      id="intro"
      class="relative flex h-screen items-center justify-center overflow-hidden"
      style="background: var(--canvas); color: var(--canvas-ink);"
    >
      <div class="px-6 text-center">
        <p
          class="reveal mb-6 text-xs uppercase tracking-[0.4em] text-black/40"
        >
          songwriting collective
        </p>
        <h1
          id="wordmark"
          class="text-[22vw] leading-none sm:text-[16vw] lg:text-[14rem]"
        >
          blanc
        </h1>
        <p
          class="reveal mx-auto mt-6 max-w-xl text-lg text-black/60 sm:text-xl"
        >
          {site.tagline}
        </p>
      </div>

      <div
        class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-xs uppercase tracking-[0.3em] text-black/40"
      >
        <span class="block">scroll</span>
      </div>
    </section>

    <!-- ============ WORLDS ============ -->
    {
      worlds.map((w) => (
        <section
          id={w.id}
          class="world relative flex min-h-screen items-center overflow-hidden px-6 py-24 sm:px-10"
          data-accent={w.accent}
          style={`background:${w.bg}; color:${w.ink};`}
        >
          {/* faded album-art collage */}
          <div class="collage-section" aria-hidden="true">
            {collageCovers.map((src) => <img src={withBase(`/${src}`)} alt="" loading="lazy" />)}
          </div>
          {/* tint + glow */}
          <div
            class="pointer-events-none absolute inset-0"
            aria-hidden="true"
            style={`background:
              linear-gradient(${w.bg}e0, ${w.bg}ee 55%, ${w.bg}f7),
              radial-gradient(60% 60% at 72% 28%, ${w.accent}26, transparent 70%),
              radial-gradient(50% 50% at 18% 82%, ${w.accent2}1f, transparent 70%);`}
          />
          <div class="relative z-10 mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
            <div>
              <p
                class="reveal mb-4 text-xs uppercase tracking-[0.35em]"
                style={`color:${w.accent}`}
              >
                {w.index} — {w.genre}
              </p>
              <h2
                class={`reveal font-${w.font} text-6xl leading-[0.95] sm:text-7xl lg:text-8xl`}
              >
                {w.name}
              </h2>
              <p
                class="reveal mt-6 max-w-lg text-lg leading-relaxed"
                style={`color:${w.muted}`}
              >
                {w.blurb}
              </p>
            </div>

            {/* planet + enter-world CTA */}
            <div class="flex flex-col items-center gap-8 lg:items-start">
              {w.planet && (
                <a
                  href={withBase(`/worlds/${w.id}`)}
                  data-speed="1.3"
                  class="reveal group relative block w-52 sm:w-64 lg:w-80"
                  aria-label={`Enter ${w.name}`}
                >
                  <div
                    class="pointer-events-none absolute inset-[6%] rounded-full opacity-40 blur-3xl transition-opacity duration-500 group-hover:opacity-70"
                    style={`background: radial-gradient(circle, ${w.accent}, transparent 68%);`}
                    aria-hidden="true"
                  />
                  <div class="planet relative aspect-square w-full">
                    <img
                      src={withBase(`/${w.planet}`)}
                      alt=""
                      aria-hidden="true"
                      class="h-full w-full object-contain"
                    />
                    {w.planetVideo && (
                      <video
                        class="planet-video lazy-planet"
                        muted
                        playsinline
                        preload="none"
                        poster={withBase(`/${w.planet}`)}
                        data-src={withBase(`/${w.planetVideo}`)}
                        data-scrub
                      />
                    )}
                  </div>
                </a>
              )}
              <div class="reveal text-center lg:text-left" data-speed="0.6">
                <a
                  href={withBase(`/worlds/${w.id}`)}
                  class="group inline-flex items-center gap-3 rounded-full border px-7 py-4 text-sm font-medium uppercase tracking-[0.2em] transition-colors hover:bg-white/5"
                  style={`border-color:${w.accent}66; color:${w.ink};`}
                >
                  Enter {w.name}
                  <span
                    class="transition-transform group-hover:translate-x-1"
                    style={`color:${w.accent}`}
                    >→</span
                  >
                </a>
                <p class="mt-3 text-sm" style={`color:${w.muted}`}>
                  explore the music &amp; artwork
                </p>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- ============ THE COLLECTIVE ============ -->
    <section
      id="collective"
      class="relative py-28"
      style="background: var(--canvas); color: var(--canvas-ink);"
    >
      <div class="mx-auto max-w-6xl px-6 sm:px-10">
        <p class="reveal text-xs uppercase tracking-[0.4em] text-black/40">
          the collective
        </p>
        <h2 class="reveal mt-4 max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">
          Three writers. One blank page.
        </h2>
      </div>

      <!-- group portrait, full-bleed cinematic (landscape screens) — colors in on scroll -->
      <div class="reveal group-photo relative mt-12 hidden md:block">
        <div class="group-photo-media group-photo-wide relative h-[92vh] min-h-[520px] w-full overflow-hidden">
          <img
            src={withBase('/members/blanc-group-wide.jpg')}
            alt="blanc — Nick Tangorra, Jacqueline Tangorra, and Rafe Tangorra"
            class="absolute inset-0 h-full w-full scale-[1.15] object-cover object-[center_22%] origin-[50%_12%]"
          />
          <video
            class="lazy-planet scale-[1.15] origin-[50%_12%]"
            style="object-position: center 22%"
            muted
            loop
            playsinline
            preload="none"
            poster={withBase('/members/blanc-group-wide.jpg')}
            data-src={withBase('/members/blanc-group-wide.mp4')}
          />
        </div>
      </div>

      <!-- group portrait, contained square (portrait screens) -->
      <div class="reveal group-photo relative mx-auto mt-12 max-w-4xl px-6 md:hidden">
        <div class="group-photo-media group-photo-fade relative overflow-hidden">
          <img
            src={withBase('/members/blanc-group.jpg')}
            alt="blanc — Nick Tangorra, Jacqueline Tangorra, and Rafe Tangorra"
            class="w-full scale-[1.15] origin-[50%_15%]"
          />
          <video
            class="lazy-planet scale-[1.15] origin-[50%_15%]"
            muted
            loop
            playsinline
            preload="none"
            poster={withBase('/members/blanc-group.jpg')}
            data-src={withBase('/members/blanc-group.mp4')}
          />
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-6 sm:px-10">
        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            members.map((m) => (
              <a
                href={withBase(`/members/${m.slug}`)}
                class="reveal group relative overflow-hidden rounded-2xl border border-black/10 p-6 transition-colors hover:border-black/30"
              >
                <div
                  class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100"
                  style={`background:${m.accent}`}
                  aria-hidden="true"
                />
                <div
                  class="flex h-40 items-center justify-center rounded-xl"
                  style={`background:${m.accent}12; color:${m.accent};`}
                >
                  {m.photo ? (
                    <img
                      src={withBase(`/${m.photo}`)}
                      alt={m.name}
                      class="h-full w-full rounded-xl object-cover object-[center_20%]"
                      loading="lazy"
                    />
                  ) : (
                    <span class="font-golden text-5xl">{initials(m.name)}</span>
                  )}
                </div>
                <h3 class="mt-5 text-2xl font-semibold tracking-tight">
                  {m.name}
                </h3>
                <p class="mt-1 text-sm text-black/50">{m.role}</p>
                <span
                  class="mt-4 inline-block text-xs uppercase tracking-[0.2em]"
                  style={`color:${m.accent}`}
                >
                  View page →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ BOOKING / CONTACT ============ -->
    <section
      id="booking"
      class="relative flex min-h-[80vh] items-center justify-center px-6 py-24 text-center"
      style="background: var(--canvas-ink); color: var(--canvas);"
    >
      <div class="max-w-2xl">
        <p class="reveal text-xs uppercase tracking-[0.4em] text-white/40">
          work with blanc
        </p>
        <h2 class="reveal mt-5 text-5xl font-semibold leading-tight sm:text-6xl">
          Let's make something<br />that has no genre.
        </h2>
        <p class="reveal mx-auto mt-6 max-w-lg text-white/60">
          Booking, sync licensing, features, co-writes — we're open. Tell us
          which world you're calling from.
        </p>
        <a
          href={`mailto:${site.bookingEmail}`}
          class="reveal mt-9 inline-block rounded-full bg-white px-8 py-3 text-sm font-medium uppercase tracking-[0.2em] text-black transition-transform hover:-translate-y-0.5"
        >
          Get in touch
        </a>
      </div>
    </section>

    <footer
      class="flex flex-col items-center justify-between gap-3 px-6 py-8 text-xs text-black/40 sm:flex-row"
      style="background: var(--canvas);"
    >
      <span class="lowercase tracking-[0.2em]">blanc</span>
      <span>© {year} blanc — one group. many worlds.</span>
    </footer>
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    const root = document.documentElement;
    root.classList.add('js');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      // ---- Smooth scroll (Lenis) wired into GSAP's ticker ----
      const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      // Anchor links scroll smoothly through Lenis
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          lenis.scrollTo(target, { offset: 0, duration: 1.2 });
        });
      });

      // ---- Intro: wordmark reacts to scroll (the signature moment) ----
      gsap.set('.reveal', { y: 32 });
      gsap.to('.reveal', {}); // no-op to ensure plugin init order

      // Intro reveal on load
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .to('#intro .reveal', { opacity: 1, y: 0, duration: 1, stagger: 0.15 }, 0.2);

      // Wordmark spreads + fades as you leave the blank page
      gsap.to('#wordmark', {
        letterSpacing: '0.15em',
        opacity: 0.15,
        ease: 'none',
        scrollTrigger: {
          trigger: '#intro',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      // ---- Per-world reveals, parallax, and nav sync ----
      gsap.utils.toArray('.world').forEach((section) => {
        const el = section as HTMLElement;

        // staggered content reveal — reverses when you scroll back up
        gsap.to(el.querySelectorAll('.reveal'), {
          opacity: 1,
          y: 0,
          duration: 1,
          ease: 'power3.out',
          stagger: 0.1,
          scrollTrigger: {
            trigger: el,
            start: 'top 68%',
            toggleActions: 'play none none reverse',
          },
        });

        // planet scrubs in with the scroll — grows/settles as the world arrives,
        // shrinks back as you leave. Fully tied to scroll position.
        const planetWrap = el.querySelector('a[aria-label^="Enter"]');
        if (planetWrap) {
          gsap.fromTo(
            planetWrap,
            { scale: 0.55, opacity: 0.3 },
            {
              scale: 1,
              opacity: 1,
              ease: 'none',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                end: 'center center',
                scrub: 0.6,
              },
            }
          );
        }

        // parallax layers
        el.querySelectorAll('[data-speed]').forEach((layer) => {
          const l = layer as HTMLElement;
          const speed = parseFloat(l.dataset.speed || '1');
          gsap.to(l, {
            yPercent: -10 * speed,
            ease: 'none',
            scrollTrigger: {
              trigger: el,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          });
        });

        // active nav dot
        const dot = document.querySelector(`[data-dot="${el.id}"] .dot`);
        ScrollTrigger.create({
          trigger: el,
          start: 'top 50%',
          end: 'bottom 50%',
          onToggle: (self) => {
            if (!dot) return;
            dot.classList.toggle('!bg-white', self.isActive);
            (dot as HTMLElement).style.transform = self.isActive ? 'scale(2)' : '';
          },
        });
      });

      // Collective section reveal — reversible
      gsap.to('#collective .reveal', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        stagger: 0.08,
        scrollTrigger: {
          trigger: '#collective',
          start: 'top 75%',
          toggleActions: 'play none none reverse',
        },
      });

      // Booking section reveal — reversible
      gsap.to('#booking .reveal', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        stagger: 0.1,
        scrollTrigger: {
          trigger: '#booking',
          start: 'top 70%',
          toggleActions: 'play none none reverse',
        },
      });

      // ---- Group portrait: emerges from the blank page — scrubbed both ways.
      // Starts oversized and drained of color, settles + floods to full color.
      gsap.utils.toArray<HTMLElement>('.group-photo-media').forEach((media) => {
        gsap.fromTo(
          media,
          { scale: 1.12, filter: 'grayscale(1) contrast(0.92) brightness(1.05)' },
          {
            scale: 1,
            filter: 'grayscale(0) contrast(1) brightness(1)',
            ease: 'none',
            scrollTrigger: {
              trigger: media,
              start: 'top 92%',
              end: 'top 30%',
              scrub: 0.5,
            },
          }
        );
      });

      // ---- Lazy living media: load as it approaches. Scrub videos never
      // autoplay — the scrollbar is their playhead. Ambient videos loop.
      const lazyPlanets = document.querySelectorAll<HTMLVideoElement>('.lazy-planet');
      if (lazyPlanets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const v = entry.target as HTMLVideoElement;
              const isScrub = v.dataset.scrub !== undefined;
              if (entry.isIntersecting) {
                if (!v.src && v.dataset.src) {
                  v.src = v.dataset.src;
                  v.preload = 'auto';
                  v.load();
                }
                if (!isScrub) v.play().catch(() => {});
              } else if (!isScrub) {
                v.pause();
              }
            });
          },
          { rootMargin: '600px' }
        );
        lazyPlanets.forEach((v) => io.observe(v));
      }

      // ---- ULTRA reactive: pin each world and let scroll drive the orb.
      // One full spin per world — the scrollbar IS the playhead, both directions.
      gsap.utils.toArray<HTMLElement>('.world').forEach((el) => {
        const vid = el.querySelector<HTMLVideoElement>('video[data-scrub]');
        if (!vid) return;
        ScrollTrigger.create({
          trigger: el,
          start: 'top top',
          end: '+=120%',
          pin: true,
          scrub: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (vid.readyState >= 2 && vid.duration) {
              vid.currentTime = Math.min(
                vid.duration - 0.05,
                self.progress * vid.duration
              );
            }
          },
        });
      });

      // ---- Scroll progress bar ----
      gsap.to('#progress', {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: document.body,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
        },
      });

      // Recalculate once fonts/layout settle
      requestAnimationFrame(() => ScrollTrigger.refresh());
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>
