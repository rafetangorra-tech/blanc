---
// "i write" retired as a game — writing is a craft, not a minigame.
// This route now forwards to inkfall, the original game from the pen's world.
import { withBase } from '../lib/url';
const target = withBase('/inkfall');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>blanc — inkfall</title>
    <link rel="canonical" href={target} />
  </head>
  <body style="background:#f7f6f4; font-family: system-ui; display:grid; place-items:center; height:100vh; margin:0;">
    <a href={target} style="color:#0a0a0a;">→ inkfall</a>
  </body>
</html>
